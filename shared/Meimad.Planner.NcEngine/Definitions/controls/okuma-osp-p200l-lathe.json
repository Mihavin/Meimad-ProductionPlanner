  "machineType": "lathe",
  "reference": "Okuma OSP-P200L Programming Manual (lathe) G/M code tables, LAP (G80-G88), compound thread cycles (G71/G72), grooving cycles (G73/G74); interpreted through the FANUC lathe interpreter after the Meimad OSP-to-FANUC translation",
  "blockEnd": ";",
  "comment": "()",
  "translation": "okuma-osp-lathe",
  "macro": {
    "dialect": "okuma-user-task-2",
    "notes": "User Task 2: common variables VC1-VC200 (translated to #501+), local variables, IF [...] Nlabel / GOTO Nlabel branching (translated to FANUC IF GOTO with numeric sequence numbers), CALL Oxxxx / RTS subprograms (translated to M98/M99), PUT / WRITE C output (ignored).",
    "controlFlow": [
      "GOTO",
      "IF GOTO",
      "CALL",
      "RTS"
    ],
    "functions": [
      "SIN",
      "COS",
      "TAN",
      "ATAN",
      "SQRT",
      "ABS",
      "ROUND",
      "FIX",
      "FUP",
      "MOD"
    ]
  },
  "modalGroups": {
    "0": "Non-modal",
    "1": "Motion",
    "2": "Constant surface speed",
    "3": "Absolute/incremental",
    "5": "Feed mode",
    "7": "Tool nose radius compensation",
    "16": "Plane selection"
  },
