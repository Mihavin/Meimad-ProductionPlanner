  "shortName": "OKUMA OSP-P200L",
  "manufacturer": "Okuma",
  "interpreter": "fanuc-lathe",
  "machineType": "lathe",
  "reference": "Okuma OSP-P200L/P20L Programming Manual LE33-013 (lathe): G/M code tables, math functions, automatic chamfering, direct taper angle, fixed cycles (G31-G35, G71-G74, G77/G78), LAP (G80-G88), User Task. Programs are run by the Meimad Okuma OSP executor (meimad-okuma.js) with OSP rules; every cycle is expanded into plain moves, so the lathe interpreter only draws and times G00/G01/G02/G03.",
  "blockEnd": ";",
  "comment": "()",
  "translation": "okuma-osp-lathe",
  "macro": {
    "dialect": "okuma-user-task",
    "notes": "User Task: common variables V1-V200, local variables (names of 2 to 4 characters), expressions in address words (X19.03-0.6, Z=V1+2), IF [..] N.. / IF [..] GOTO N.. / IF name N.. / GOTO N.., CALL O.. Q.. with variable settings and RTS are executed. MODIN/MODOUT and the I/O statements (PUT, GET, READ, WRITE) are not simulated; system variables read as 0.",
    "controlFlow": [
      "GOTO",
      "IF",
      "CALL",
      "RTS"
    ],
    "functions": [
      "SIN",
      "COS",
      "TAN",
      "ATAN",
      "ATAN2",
      "SQRT",
      "ABS",
      "BIN",
      "BCD",
      "ROUND",
      "FIX",
      "FUP",
      "DROUND",
      "DFIX",
      "DFUP",
      "MOD"
    ]
  },
  "modalGroups": {
    "0": "Non-modal",
    "1": "Motion",
    "2": "Constant surface speed",
    "3": "Absolute/incremental",
    "5": "Feed mode",
    "7": "Tool nose radius compensation",
    "16": "Plane selection"
  },
