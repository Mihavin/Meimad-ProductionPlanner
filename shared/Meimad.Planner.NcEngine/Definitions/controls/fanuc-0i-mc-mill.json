{
  "schemaVersion": 1,
  "id": "fanuc-0i-mc-mill",
  "name": "FANUC Series 0i-MC / 0i-Mate-MC (machining center)",
  "shortName": "FANUC 0i-MC",
  "manufacturer": "FANUC",
  "interpreter": "fanuc-mill",
  "machineType": "mill",
  "reference": "FANUC Series 0i-MC Operator's Manual B-64124EN (G code table, chapter 3) and 0i Mate-MC B-64144EN; entries reuse the vendored Series 30i table",
  "blockEnd": ";",
  "comment": "()",
  "macro": {
    "dialect": "fanuc-custom-macro-b",
    "controlFlow": [
      "GOTO",
      "IF GOTO",
      "IF THEN",
      "WHILE DO END"
    ],
    "functions": [
      "SIN",
      "COS",
      "TAN",
      "ASIN",
      "ACOS",
      "ATAN",
      "SQRT",
      "ABS",
      "ROUND",
      "FIX",
      "FUP",
      "LN",
      "EXP",
      "POW",
      "MIN",
      "MAX",
      "ADP",
      "BIN",
      "BCD",
      "MOD",
      "AND",
      "OR",
      "XOR",
      "PRM"
    ],
    "notes": "0i-MC custom macro B: local #1-#33, common #100-#199 and #500-#999, tool offsets in memory C #10001+/#11001+ (H wear/geometry) and #12001+/#13001+ (D wear/geometry), work offsets #5201+ (EXT), #5221+ (G54-G59), #7001+ (G54.1 P1-P48 option). No tilted working plane, TCP or 5-axis functions."
  },
  "modalGroups": {
    "0": "Non-modal",
    "1": "Motion",
    "2": "Plane selection",
    "3": "Absolute/incremental",
    "4": "Stored stroke check",
    "5": "Feed mode",
    "6": "Input units",
    "7": "Cutter compensation",
    "8": "Tool length compensation / tool center point control",
    "9": "Canned cycle",
