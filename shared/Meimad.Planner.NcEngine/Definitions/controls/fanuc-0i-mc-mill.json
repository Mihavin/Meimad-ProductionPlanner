    "12": "Macro modal call",
    "13": "Constant surface speed",
    "14": "Work coordinate system",
    "15": "Cutting mode",
    "16": "Coordinate rotation / tilted working plane",
    "17": "Polar coordinates command",
    "18": "Normal direction control",
    "19": "Spindle speed fluctuation detection",
    "20": "In-feed control",
    "21": "Polar coordinate interpolation",
    "22": "Programmable mirror image",
    "23": "Rotary table dynamic fixture offset",
    "24": "Electronic gear box 2 pair",
    "27": "Spindle unit compensation",
    "31": "Polygon turning",
    "33": "Workpiece setting error compensation",
    "34": "Electronic gear box"
  },
