{
  "schemaVersion": 1,
  "id": "mazak-matrix2-mill",
  "name": "Mazak MAZATROL MATRIX 2, EIA/ISO program (machining center)",
  "shortName": "MAZAK MATRIX 2 EIA",
  "manufacturer": "Yamazaki Mazak",
  "interpreter": "fanuc-mill",
  "machineType": "mill",
  "reference": "MAZATROL MATRIX EIA/ISO Programming Manual (machining centers) and the Mazak M-series G code list; the EIA dialect follows the FANUC 30i table, whose vendored entries are reused",
  "blockEnd": ";",
  "comment": "()",
  "translation": "mazak-tilt-a-as-b",
  "macro": {
    "dialect": "mazak-eia-macro",
    "controlFlow": [
      "GOTO",
      "IF GOTO",
      "IF THEN",
      "WHILE DO END"
    ],
    "functions": [
      "SIN",
      "COS",
      "TAN",
      "ASIN",
      "ACOS",
      "ATAN",
      "SQRT",
      "ABS",
      "ROUND",
      "FIX",
      "FUP",
      "LN",
      "EXP",
      "POW",
      "MIN",
      "MAX",
      "ADP",
      "BIN",
      "BCD",
      "MOD",
      "AND",
      "OR",
      "XOR",
      "PRM"
    ],
    "notes": "Mazak EIA user macros use the FANUC custom macro B syntax (#1-#33 local, #100-#199 / #500-#999 common, #5221+ work offsets). Tilted working plane G68.2, tool axis direction control G53.1 and tool tip point control G43.4/G43.5 are the Variaxis 5-axis functions; the Meimad adapter renames the A-axis tilt to B for the interpreter (see Definitions/machines/mazak-variaxis-i-500.json)."
  },
