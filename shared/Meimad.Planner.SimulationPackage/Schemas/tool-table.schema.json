{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-table.schema.json",
  "title": "Meimad simulation package tool table, schemaVersion 1",
  "description": "The tools the package NC program calls, keyed by the same T-number the NC program, the Cimatron *.TOOLS.mht report and the cutters/holders CSV exports use. Lengths are millimetres. A tool without complete holder dimensions is accepted with the holder_dimensions_incomplete warning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "units", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "units": { "const": "mm" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application": { "type": "string", "maxLength": 64 },
        "ncFileName": { "type": "string", "maxLength": 255 },
        "exportedAtUtc": { "type": "string", "maxLength": 40 }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "length": { "type": "number", "minimum": 0, "maximum": 10000 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name"],
      "properties": {
        "number": { "type": "integer", "minimum": 0, "maximum": 99999 },
        "toolIdentifier": {
          "description": "The T-word of the tool (T + number), so the file is also a structured JSON tool table the Server accepts for an NC release.",
          "type": "string",
          "pattern": "^T[0-9]{1,5}$"
        },
        "description": { "type": "string", "maxLength": 240 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "enum": ["flat", "ball", "bull-nose", "taper", "drill", "tap", "chamfer", "thread-mill", "face-mill", "other"] },
        "cutterId": { "type": "string", "maxLength": 200 },
        "diameterMm": { "$ref": "#/$defs/length" },
        "cornerRadiusMm": { "$ref": "#/$defs/length" },
        "fluteLengthMm": { "$ref": "#/$defs/length" },
        "gaugeLengthMm": { "$ref": "#/$defs/length" },
        "taperAngleDeg": { "type": "number", "minimum": 0, "maximum": 180 },
        "holder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "holderId": { "type": "string", "maxLength": 200 },
            "name": { "type": "string", "maxLength": 200 },
            "diameterMm": { "$ref": "#/$defs/length" },
            "lengthMm": { "$ref": "#/$defs/length" }
          }
        },
        "procedures": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
