<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <RootNamespace>Meimad.Planner.Server</RootNamespace>
    <AssemblyName>Meimad.Planner.Server</AssemblyName>
    <Version>0.1.129</Version>
    <!-- Keep disposable local publish intermediates out of the SDK source glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.publish-temp\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Meimad.Planner.NcEngine\Meimad.Planner.NcEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FANUC FOCAS 2 library (Fwlib64.dll, fwlibe64.dll, fwlib*64.dll). It is FANUC-licensed and
      kept out of version control; when the repository's focas\ folder holds it, the build copies
      it into the Server's focas\ subfolder and the installer payload picks it up from there.
      The Server is x64-only, so only the "*64.dll" binaries (FANUC's own 64-bit naming
      convention: Fwlib64.dll, fwlibe64.dll, and the 64-bit control-series libraries) are taken;
      the focas\ folder may also hold unrelated 32-bit copies, sample-project source, or other
      platform binaries that must not ship.
    -->
    <None Include="..\..\focas\*64.dll"
          Link="focas\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="KitaronSetup\index.html"
             Link="wwwroot\kitaron-setup\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="KitaronSetup\styles.css"
             Link="wwwroot\kitaron-setup\styles.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="KitaronSetup\app.js"
             Link="wwwroot\kitaron-setup\app.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\client-tv-dashboard\index.html"
             Link="wwwroot\tv-dashboard\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\client-tv-dashboard\styles.css"
             Link="wwwroot\tv-dashboard\styles.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\client-tv-dashboard\app.js"
             Link="wwwroot\tv-dashboard\app.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EInkSimulator\index.html"
             Link="wwwroot\eink-simulator\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="EInkSimulator\styles.css"
             Link="wwwroot\eink-simulator\styles.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="EInkSimulator\app.js"
             Link="wwwroot\eink-simulator\app.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="EInkSimulator\power-policy.js"
             Link="wwwroot\eink-simulator\power-policy.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
