<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <RootNamespace>Meimad.Planner.Server</RootNamespace>
    <AssemblyName>Meimad.Planner.Server</AssemblyName>
    <Version>0.1.34</Version>
    <!-- Keep disposable local publish intermediates out of the SDK source glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.publish-temp\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="KitaronSetup\index.html"
             Link="wwwroot\kitaron-setup\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="KitaronSetup\styles.css"
             Link="wwwroot\kitaron-setup\styles.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="KitaronSetup\app.js"
             Link="wwwroot\kitaron-setup\app.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\client-tv-dashboard\index.html"
             Link="wwwroot\tv-dashboard\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\client-tv-dashboard\styles.css"
             Link="wwwroot\tv-dashboard\styles.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\client-tv-dashboard\app.js"
             Link="wwwroot\tv-dashboard\app.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EInkSimulator\index.html"
             Link="wwwroot\eink-simulator\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="EInkSimulator\styles.css"
             Link="wwwroot\eink-simulator\styles.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="EInkSimulator\app.js"
             Link="wwwroot\eink-simulator\app.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
