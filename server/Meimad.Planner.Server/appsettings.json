{
  "Server": {
    "Host": "127.0.0.1",
    "Port": 5080,
    "ServiceName": "Meimad Planner Server"
  },
  "Database": {
    "Path": "data/meimad-planner.db"
  },
  "Backup": {
    "Folder": "backups",
    "RetentionCount": 14
  },
  "EditMode": {
    "TransferTimeoutSeconds": 30
  },
  "TvDashboard": {
    "RefreshAfterSeconds": 15,
    "UrgentWithinHours": 48,
    "CalculationHorizonDays": 7
  },
  "Timeline": {
    "DayShiftStartsAtLocal": "06:00",
    "DayShiftEndsAtLocal": "18:00",
    "TimeZoneId": "Asia/Jerusalem"
  },
  "LegacyImport": {
    "PreviewLifetimeMinutes": 120
  },
  "EInk": {
    "PackageRoot": "eink-packages",
    "TimeZoneId": "Asia/Jerusalem",
    "Workdays": ["sunday", "monday", "tuesday", "wednesday", "thursday"],
    "ShiftStartsAtLocal": "06:00",
    "ShiftEndsAtLocal": "18:00",
    "PollIntervalSeconds": 300,
    "MaximumRetryAttempts": 3,
    "InitialBackoffSeconds": 15,
    "MaximumPackageFileBytes": 26214400,
    "MaximumPackageBytes": 104857600,
    "MaximumPackageAssets": 64,
    "MaximumGeneratedTextCharacters": 100000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
