<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Meimad-Planner-Client-Setup</OutputName>
    <OutputPath Condition="'$(InstallerOutputPath)' != ''">$(InstallerOutputPath)\</OutputPath>
    <GeneratedPayloadFile Condition="'$(GeneratedPayloadFile)' == ''">$(MSBuildThisFileDirectory)..\obj\generated\ClientPayload.wxs</GeneratedPayloadFile>
    <ClientExecutableDir Condition="'$(ClientExecutableDir)' == ''">$(MSBuildThisFileDirectory)..\obj\publish\client</ClientExecutableDir>
    <DefineConstants>ClientExecutableDir=$(ClientExecutableDir)</DefineConstants>
    <!-- ICE61 is expected because AllowSameVersionUpgrades permits emergency same-version rebuilds. -->
    <SuppressIces>ICE61;ICE90</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GeneratedPayloadFile)" />
  </ItemGroup>
</Project>
