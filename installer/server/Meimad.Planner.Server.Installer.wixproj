<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Meimad-Planner-Server-Setup</OutputName>
    <OutputPath Condition="'$(InstallerOutputPath)' != ''">$(InstallerOutputPath)\</OutputPath>
    <GeneratedPayloadFile Condition="'$(GeneratedPayloadFile)' == ''">$(MSBuildThisFileDirectory)..\obj\generated\ServerPayload.wxs</GeneratedPayloadFile>
    <ServerExecutableDir Condition="'$(ServerExecutableDir)' == ''">$(MSBuildThisFileDirectory)..\obj\publish\server</ServerExecutableDir>
    <DefineConstants>ServerExecutableDir=$(ServerExecutableDir)</DefineConstants>
    <!-- ICE61 is expected because AllowSameVersionUpgrades intentionally supports refreshed 0.1.2 builds. -->
    <SuppressIces>ICE60;ICE61</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GeneratedPayloadFile)" />
  </ItemGroup>
</Project>
