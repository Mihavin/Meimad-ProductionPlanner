<UserControl x:Class="Meimad.Planner.Client.Windows.Views.UserAdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
      <StackPanel>
        <TextBlock Text="Users and permissions" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Accounts sign in to the Planner; their user types decide what they may change. Everyone may view Cases, the Planning Board, the Timeline, NC files, tool tables and the tool library, and create Production Packages."
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Users -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="New user" Command="{Binding NewUserCommand}" Margin="0" />
          <TextBlock Text="Users" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  AutomationProperties.Name="Users">
          <DataGrid.Columns>
            <DataGridTextColumn Header="User name" Binding="{Binding UserName}" Width="110" />
            <DataGridTextColumn Header="Full name" Binding="{Binding DisplayName}" Width="140" />
            <DataGridTextColumn Header="User types" Binding="{Binding TypesText}" Width="*" />
            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="130" />
            <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastSignInText}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" BorderBrush="{StaticResource GreyBrush}" BorderThickness="1" Padding="10" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="{Binding UserEditorTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="User name" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewUser}"
                         ToolTip="The name used to sign in; it cannot change after the account is created" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Full name" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Active (may sign in)" IsChecked="{Binding UserIsActive}" Margin="0,8,0,0" />
            <TextBlock Text="User types" Margin="0,8,0,2" />
            <ItemsControl ItemsSource="{Binding UserTypeChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Description}" Margin="0,2,14,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Temporary password" Margin="0,8,0,2" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Reset password" Command="{Binding ResetPasswordCommand}" Margin="8,0,0,0"
                      ToolTip="Give the selected user this temporary password; their open sessions end and they choose a new password at the next sign-in" />
              <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="At least 6 characters. Needed for a new user or a reset; the user replaces it at the first sign-in" />
            </DockPanel>
            <Button Content="Save user" Command="{Binding SaveUserCommand}" HorizontalAlignment="Right" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- User types -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="New user type" Command="{Binding NewTypeCommand}" Margin="0" />
          <TextBlock Text="User types" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding UserTypes}" SelectedItem="{Binding SelectedType}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  AutomationProperties.Name="User types">
          <DataGrid.Columns>
            <DataGridTextColumn Header="User type" Binding="{Binding Name}" Width="150" />
            <DataGridTextColumn Header="Users" Binding="{Binding UserCount}" Width="55" />
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" BorderBrush="{StaticResource GreyBrush}" BorderThickness="1" Padding="10" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="{Binding TypeEditorTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding TypeNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
            <TextBlock Text="Name" />
            <TextBox Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTypeEditable}" />
            <TextBlock Text="Description" Margin="0,6,0,0" />
            <TextBox Text="{Binding TypeDescription, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTypeEditable}" />
            <TextBlock Text="Permissions" Margin="0,8,0,2" />
            <ItemsControl ItemsSource="{Binding PermissionChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" Margin="0,2">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button Content="Remove user type" Command="{Binding DeleteTypeCommand}"
                      ToolTip="Remove a user type that no account uses" />
              <Button Content="Save user type" Command="{Binding SaveTypeCommand}" Margin="0" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
