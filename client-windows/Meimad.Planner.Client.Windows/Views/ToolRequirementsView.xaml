<UserControl x:Class="Meimad.Planner.Client.Windows.Views.ToolRequirementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CanvasBrush}">
  <UserControl.Resources>
    <CollectionViewSource x:Key="GroupedTools" Source="{Binding Items}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="MaterialText" />
        <PropertyGroupDescription PropertyName="TypeText" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Export to Excel…" Click="Export_Click" IsEnabled="{Binding IsConnected}" Margin="8,0,0,0"
              ToolTip="Save the period's tool requirements as an Excel workbook: tools, uses and operations without a tool table" />
      <Button DockPanel.Dock="Right" Content="Calculate" Command="{Binding RefreshCommand}"
              ToolTip="Read the planned operations of the period from the Timeline and list their tools" />
      <StackPanel>
        <TextBlock Text="Tool Requirements" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="The tools the operations planned on the Timeline need in the period, from their released tool tables, by material, type, size and name. One copy moves to another machine when its uses do not overlap in time."
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
      <DatePicker SelectedDate="{Binding FromDate}" Width="130" />
      <TextBlock Text="To" VerticalAlignment="Center" Margin="14,0,6,0" />
      <DatePicker SelectedDate="{Binding ToDate}" Width="130" ToolTip="The last day of the period" />
      <TextBlock Text="Search" VerticalAlignment="Center" Margin="18,0,6,0" />
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240"
               ToolTip="Tool name, type, material, machine, diameter, work order or part" />
    </StackPanel>
    <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <DataGrid Grid.Row="3" ItemsSource="{Binding Source={StaticResource GroupedTools}}" SelectedItem="{Binding SelectedItem}"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"
              AutomationProperties.Name="Tool requirements">
      <DataGrid.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,6,2,2" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </DataGrid.GroupStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Ø (mm)" Binding="{Binding DiameterText}" Width="70" />
        <DataGridTextColumn Header="Tool" Binding="{Binding ToolName}" Width="190" />
        <DataGridTextColumn Header="Copies" Binding="{Binding CopiesNeeded}" Width="60" />
        <DataGridTextColumn Header="Sharing" Binding="{Binding SharingText}" Width="170" />
        <DataGridTextColumn Header="Machines" Binding="{Binding MachinesText}" Width="220" />
        <DataGridTextColumn Header="Uses" Binding="{Binding UseCount}" Width="50" />
        <DataGridTextColumn Header="Machine changes" Binding="{Binding MachineChanges}" Width="110" />
        <DataGridTextColumn Header="First need" Binding="{Binding FirstNeedText}" Width="95" />
        <DataGridTextColumn Header="Last need" Binding="{Binding LastNeedText}" Width="95" />
        <DataGridTextColumn Header="Type from" Binding="{Binding TypeSourceText}" Width="*" MinWidth="100" />
      </DataGrid.Columns>
    </DataGrid>
    <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <GroupBox Header="Copies and their route" Margin="0,0,8,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding SelectedRoute}" TextWrapping="Wrap" Margin="4" FontFamily="Consolas" />
        </ScrollViewer>
      </GroupBox>
      <GroupBox Grid.Column="1" Header="Operations using the tool">
        <DataGrid ItemsSource="{Binding SelectedUses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Operations using the tool">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrderNumber}" Width="90" />
            <DataGridTextColumn Header="Part" Binding="{Binding PartNumber}" Width="140" />
            <DataGridTextColumn Header="Operation" Binding="{Binding OperationText}" Width="180" />
            <DataGridTextColumn Header="Machine" Binding="{Binding MachineLabel}" Width="150" />
            <DataGridTextColumn Header="Tool numbers" Binding="{Binding ToolNumbersText}" Width="90" />
            <DataGridTextColumn Header="Holder" Binding="{Binding Holder}" Width="130" />
            <DataGridTextColumn Header="Stick-out (mm)" Binding="{Binding LengthText}" Width="95" />
            <DataGridTextColumn Header="From" Binding="{Binding FromText}" Width="90" />
            <DataGridTextColumn Header="To" Binding="{Binding ToText}" Width="90" />
            <DataGridTextColumn Header="Part material" Binding="{Binding Material}" Width="*" MinWidth="160" />
          </DataGrid.Columns>
        </DataGrid>
      </GroupBox>
    </Grid>
    <Expander Grid.Row="6" Margin="0,8,0,0" Header="Planned operations without a released tool table">
      <DataGrid ItemsSource="{Binding OperationsWithoutToolTable}" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" MaxHeight="180" AutomationProperties.Name="Planned operations without a released tool table">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrderNumber}" Width="90" />
          <DataGridTextColumn Header="Part" Binding="{Binding PartNumber}" Width="140" />
          <DataGridTextColumn Header="Operation" Binding="{Binding OperationText}" Width="200" />
          <DataGridTextColumn Header="Machine" Binding="{Binding MachineLabel}" Width="150" />
          <DataGridTextColumn Header="Material" Binding="{Binding MaterialText}" Width="120" />
          <DataGridTextColumn Header="From" Binding="{Binding FromText}" Width="90" />
          <DataGridTextColumn Header="To" Binding="{Binding ToText}" Width="*" MinWidth="90" />
        </DataGrid.Columns>
      </DataGrid>
    </Expander>
  </Grid>
</UserControl>
