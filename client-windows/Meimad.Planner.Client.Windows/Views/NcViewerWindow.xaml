<Window x:Class="Meimad.Planner.Client.Windows.Views.NcViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NC Viewer" Icon="/Meimad.Planner.Client.Windows;component/Assets/MeimadPlanner.ico"
        Width="1480" Height="920" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F1720">
    <Grid>
        <!-- The page lays itself out left to right (code, toolpath); Hebrew text is aligned inside it. -->
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0F1720" FlowDirection="LeftToRight" />
        <DockPanel x:Name="FallbackPanel" Visibility="Collapsed" Background="White">
            <Border DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#C98A00" BorderThickness="0,0,0,1" Padding="12,8">
                <TextBlock x:Name="FallbackMessage" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>
            <TextBox x:Name="FallbackText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="NC program text" />
        </DockPanel>
    </Grid>
</Window>
