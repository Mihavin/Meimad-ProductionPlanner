<Window Style="{DynamicResource {x:Type Window}}" x:Class="Meimad.Planner.Client.Windows.Views.OperationTimeStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operation statistics" Width="1080" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,8">
      <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" />
      <TextBlock x:Name="OperationTimesText" Margin="0,4,0,0" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                 Text="Planning uses the real median of this Operation on the assigned Machine (the last 10 measurements); without one, the NC time; without NC, the Operation's own time. Apply writes a time to the Case Operation: pending Work Orders take it now, released ones on Refresh from Case." />
    </StackPanel>
    <TextBlock Grid.Row="1" Text="Times by Machine" FontWeight="SemiBold" Margin="0,4,0,4" />
    <DataGrid x:Name="TimesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.Name="Times by Machine">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Machine" Binding="{Binding MachineText}" Width="1.4*" />
        <DataGridTextColumn Header="Time" Binding="{Binding KindText}" Width="*" />
        <DataGridTextColumn Header="Operation" Binding="{Binding OperationText}" Width="*" />
        <DataGridTextColumn Header="NC time" Binding="{Binding NcText}" Width="*" />
        <DataGridTextColumn Header="Real median" Binding="{Binding RealText}" Width="1.3*" />
        <DataGridTextColumn Header="Used for planning" Binding="{Binding UsedText}" Width="*" />
        <DataGridTemplateColumn Header="Apply to Operation" Width="190">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="Apply NC" Click="ApplyNc_Click" IsEnabled="{Binding CanApplyNc}" Margin="0,0,6,0" Padding="8,1"
                        ToolTip="Write the current NC release's time on this Machine to the Case Operation"
                        AutomationProperties.Name="Apply NC time" />
                <Button Content="Apply real" Click="ApplyReal_Click" IsEnabled="{Binding CanApplyReal}" Padding="8,1"
                        ToolTip="{Binding ApplyRealToolTip}" AutomationProperties.Name="Apply real time" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" Text="Collected times (newest first; ✓ = in the median)" FontWeight="SemiBold" Margin="0,10,0,4" />
    <DataGrid x:Name="SamplesGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" HeadersVisibility="Column" AutomationProperties.Name="Collected times">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Measured at" Binding="{Binding MeasuredAtText}" Width="140" />
        <DataGridTextColumn Header="Machine" Binding="{Binding MachineText}" Width="*" />
        <DataGridTextColumn Header="Time" Binding="{Binding KindText}" Width="*" />
        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="*" />
        <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="*" />
        <DataGridTextColumn Header="Work Order" Binding="{Binding BatchNumber}" Width="*" />
        <DataGridTextColumn Header="In median" Binding="{Binding InMedianText}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="5" Text="History of the Operation's times" FontWeight="SemiBold" Margin="0,10,0,4" />
    <DataGrid x:Name="HistoryGrid" Grid.Row="6" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" HeadersVisibility="Column" AutomationProperties.Name="History of the Operation's times">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Changed at" Binding="{Binding ChangedAtText}" Width="140" />
        <DataGridTextColumn Header="Time" Binding="{Binding KindText}" Width="*" />
        <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="1.4*" />
        <DataGridTextColumn Header="From" Binding="{Binding FromText}" Width="*" />
        <DataGridTextColumn Header="To" Binding="{Binding ToText}" Width="*" />
        <DataGridTextColumn Header="By" Binding="{Binding ChangedBy}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="7" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True" Click="Close_Click" />
      <Button DockPanel.Dock="Right" Content="Refresh" Width="90" Margin="0,0,8,0" Click="Refresh_Click" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </Grid>
</Window>
