<Window x:Class="Meimad.Planner.Client.Windows.Views.ToolCatalogPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a catalog tool" Width="860" Height="520" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Width="90" Click="Search_Click" />
      <TextBox x:Name="SearchBox" KeyDown="Search_KeyDown" AutomationProperties.Name="Search tools"
               ToolTip="Internal id, name, description or an external id; press Enter" />
    </DockPanel>
    <DataGrid x:Name="ToolsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" MouseDoubleClick="ToolsGrid_MouseDoubleClick"
              AutomationProperties.Name="Catalog tools">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Internal id" Binding="{Binding InternalCode}" Width="90" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
        <DataGridTextColumn Header="Type" Binding="{Binding ToolType}" Width="150" />
        <DataGridTextColumn Header="Hand" Binding="{Binding Hand}" Width="70" />
        <DataGridTextColumn Header="External ids" Binding="{Binding ExternalIdsText}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Use this tool" Width="120" Margin="0,0,8,0" Click="Use_Click" IsDefault="True" />
        <Button Content="Cancel" Width="90" IsCancel="True" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </Grid>
</Window>
