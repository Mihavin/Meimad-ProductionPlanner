<UserControl x:Class="Meimad.Planner.Client.Windows.Views.OperationalHealthView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Operational health" FontSize="22" FontWeight="SemiBold" />
   <TextBlock Text="Connection, freshness and successful outcomes are separate facts." Margin="0,5" TextWrapping="Wrap" />
   <WrapPanel><Button Content="Refresh" Command="{Binding RefreshCommand}" /><Button Content="Load more" Command="{Binding MoreCommand}" /></WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6" />
  </StackPanel>
  <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True"
            CanUserAddRows="False" SelectionMode="Single" RowDetailsVisibilityMode="VisibleWhenSelected" AutomationProperties.Name="Integration health observations">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="110" />
    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
    <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="160" />
    <DataGridTextColumn Header="Freshness" Binding="{Binding Freshness}" Width="110" />
    <DataGridTextColumn Header="Last attempt (UTC)" Binding="{Binding LastAttemptAt, StringFormat=u}" Width="180" />
    <DataGridTextColumn Header="Last success (UTC)" Binding="{Binding LastSucceededAt, StringFormat=u}" Width="180" />
    <DataGridTextColumn Header="Observed (UTC)" Binding="{Binding ObservedAt, StringFormat=u}" Width="180" />
   </DataGrid.Columns>
   <DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="12" MaxWidth="1000">
    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding EntityId}" FontFamily="Consolas" FlowDirection="LeftToRight" TextWrapping="Wrap" />
    <TextBlock Text="{Binding SourceVersion}" FontFamily="Consolas" FlowDirection="LeftToRight" TextWrapping="Wrap" />
   </StackPanel></DataTemplate></DataGrid.RowDetailsTemplate>
  </DataGrid>
 </DockPanel>
</UserControl>
