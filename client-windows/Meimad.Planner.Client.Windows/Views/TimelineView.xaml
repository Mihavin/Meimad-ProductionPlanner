<UserControl x:Class="Meimad.Planner.Client.Windows.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="500">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#D8DDE3"
                BorderThickness="1" CornerRadius="5" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="From (UTC)" FontWeight="SemiBold" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="135" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="To (UTC, exclusive)" FontWeight="SemiBold" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="135" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="Calculate / Refresh" Command="{Binding RefreshCommand}" Margin="0" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="TIMELINE" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="One read-only Server Timeline. Each assignment's planning mode controls that operation's calculated position."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D8DDE3" BorderThickness="1"
                CornerRadius="5" Padding="8" Margin="0,6,0,0">
            <WrapPanel>
                <TextBlock Text="LEGEND" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="12" Background="#1E88E5" /><TextBlock Text="OPERATION" Margin="5,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="12" Background="#7E57C2" /><TextBlock Text="WAITING" Margin="5,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="12" Background="#9E9E9E" /><TextBlock Text="IDLE" Margin="5,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="12" Background="#C62828" /><TextBlock Text="DOWNTIME" Margin="5,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="#F57C00" /><TextBlock Text="RESERVED" Margin="5,0,0,0" /></StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8DDE3" BorderThickness="1"
                CornerRadius="5" Padding="7" Margin="0,6,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="330">
                <Canvas x:Name="TimelineCanvas" MinHeight="120" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8DDE3" BorderThickness="1"
                    CornerRadius="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="CONFLICTS" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Each status includes a severity label; color is supplemental."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,10" />
                    <ItemsControl ItemsSource="{Binding Conflicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="4,0,0,0"
                                        Background="#FAFAFA" Padding="10" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="blocking"><Setter Property="BorderBrush" Value="{StaticResource RedBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="warning"><Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SeverityLabel}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding DisplayMessage}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Code}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D8DDE3" BorderThickness="1"
                    CornerRadius="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="SELECTED BATCH DEPENDENCIES" FontWeight="Bold" FontSize="16" />
                    <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                              DisplayMemberPath="DisplayName" Margin="0,9,0,10" MinHeight="34" />
                    <TextBlock Text="Only dependency edges for the selected batch are shown."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding SelectedDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F3F5F7" BorderBrush="#D8DDE3" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RuleLabel}" Foreground="#1E88E5" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
