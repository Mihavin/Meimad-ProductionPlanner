<Window x:Class="Meimad.Planner.Client.Windows.Views.ProductionReadinessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Production readiness" Width="680" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinWidth="580" MinHeight="560">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="OperationTitle" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,5,0,10" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Border Grid.Row="2" BorderBrush="#D5DAE0" BorderThickness="1" CornerRadius="3" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Components">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E8EB" BorderThickness="0,0,0,1" Padding="2,7">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontWeight="Bold" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Current compatible G-code release" FontWeight="SemiBold"/>
            <ComboBox x:Name="Release" Margin="0,3,0,0" MinHeight="27"/>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <CheckBox x:Name="MaterialReady" Content="Material physically confirmed" FontWeight="SemiBold"/>
                <TextBox x:Name="MaterialComment" Margin="0,4,0,0" MinHeight="44" MaxLength="2000"
                         AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Optional physical material verification note."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <CheckBox x:Name="OffsetsReady" Content="Tool offsets confirmed" FontWeight="SemiBold"/>
                <TextBox x:Name="OffsetsComment" Margin="0,4,0,0" MinHeight="44" MaxLength="2000"
                         AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Optional offset verification note for this Machine, process revision, and G-code release."/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="5" Margin="0,9,0,0" Foreground="#5F6B76" TextWrapping="Wrap"
                   Text="Confirmations apply only to the assigned Machine and current production configuration. A later process or G-code release may require new offset confirmation."/>
        <TextBlock x:Name="Validation" Grid.Row="6" Margin="0,7,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save readiness inputs" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
