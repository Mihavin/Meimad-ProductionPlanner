<UserControl x:Class="Meimad.Planner.Client.Windows.Views.CaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Meimad.Planner.Client.Windows.Views"
             MinHeight="560">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FormField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="#D8DDE3"
            BorderThickness="1"
            CornerRadius="5"
            Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="CASE POOL" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Part masters from the Server" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,9" />
                    <TextBlock Text="Search Part Number, name, or customer" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Customer filter" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Active state" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ActiveFilters}"
                                      SelectedItem="{Binding ActiveFilter}"
                                      MinHeight="38"
                                      Padding="7" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Sort Cases by" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding CaseSortOptions}"
                                  SelectedItem="{Binding CaseSort}"
                                  MinHeight="38"
                                  Padding="7" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
                        <Button Command="{Binding SearchCommand}" Style="{StaticResource TemplateIconButton}"
                                ToolTip="Search Cases" AutomationProperties.Name="Search Cases">
                            <Image Source="{StaticResource SearchButtonIcon}" Width="24" Height="24" />
                        </Button>
                        <Button Content="Clear" Command="{Binding ClearFiltersCommand}" />
                        <Button Content="Add Case" Command="{Binding BeginCreateCommand}" Margin="0" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="CasePoolList" Grid.Row="2"
                         ItemsSource="{Binding Cases}"
                         SelectedItem="{Binding SelectedCase}"
                         BorderBrush="#D8DDE3"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="7" Margin="1" BorderBrush="#E2E6EA" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="9" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="68" Height="52" Background="#EEF1F4" BorderBrush="#D4D9DE" BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            <TextBlock Text="No preview" FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PartNumber}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Customer}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ActiveStateText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasForm}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Delete Case" Click="DeleteCase_Click" IsEnabled="{Binding CanDeleteCase}" />
                        <Button Content="Open Working Folder" Command="{Binding OpenWorkingFolderCommand}" />
                        <Button Content="Refresh Case" Command="{Binding RefreshDetailsCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding FormHeading}" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding PartNumber}" FontSize="22" FontWeight="Bold" />
                            <Border Background="#E8EEF4" CornerRadius="3" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ActiveStateText}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TabControl Grid.Row="1">
                    <TabItem Header="Case form">
                        <ScrollViewer x:Name="CaseEditScroll"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Padding="14">
                            <StackPanel>
                                <Border Background="#FFF4CE" BorderBrush="#D6B656" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding CaseAuthorityText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </Border>
                                <Border Height="120" Background="#EEF1F4" BorderBrush="#D4D9DE" BorderThickness="1" Margin="0,0,0,10">
                                    <Grid>
                                        <Image Source="{Binding DetailPreview}" Stretch="Uniform" />
                                        <TextBlock Text="No preview" Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <UniformGrid Columns="2">
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Part Number" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PartNumber}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Revision" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Revision}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Customer" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Customer}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Customer Reference" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CustomerReference}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Material Type" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaterialType}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Material Specification" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaterialSpecification}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Raw Material Form" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RawMaterialForm}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Raw Material Dimensions" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RawMaterialDimensions}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Total Setup Time (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CurrentSetupTime, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" ToolTip="Read-only sum of setup time across all Case Operations."/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Total Cycle Time / Part (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CurrentCycleTimePerPart, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" ToolTip="Read-only sum of cycle time per part across all Case Operations."/></StackPanel>
                                </UniformGrid>
                                <StackPanel Style="{StaticResource FormField}">
                                    <TextBlock Text="Case Working Folder (external path)" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse Folder…" Click="BrowseFolder_Click"
                                                IsEnabled="{Binding CanEditForm}" Margin="8,0,0,0" />
                                        <TextBox Text="{Binding WorkingFolderPath}" IsReadOnly="{Binding IsFormReadOnly}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormField}">
                                    <TextBlock Text="Picture Path (server-readable path only)" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse Picture…" Click="BrowsePicture_Click"
                                                IsEnabled="{Binding CanEditForm}" Margin="8,0,0,0" />
                                        <TextBox Text="{Binding PreviewPath}" IsReadOnly="{Binding IsFormReadOnly}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Notes}" IsReadOnly="{Binding IsFormReadOnly}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"/></StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Saving requires active Server-issued Edit Mode." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Cancel New Case" Command="{Binding CancelCreateCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="STEP Viewer" ToolTip="Open a local .stp or .step model and create a Case preview image">
                        <ScrollViewer x:Name="StepTabScroll" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <Grid Margin="8" MinHeight="600">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Open STEP…" Click="OpenStep_Click" />
                                    <Button x:Name="SnapshotStepButton" Content="Snapshot and use as Case image"
                                            Click="SnapshotStep_Click" IsEnabled="False" Margin="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Isometric" Click="StepIsometric_Click" />
                                    <Button Content="Front" Click="StepFront_Click" />
                                    <Button Content="Top" Click="StepTop_Click" />
                                    <Button Content="Right" Click="StepRight_Click" />
                                    <Button Content="Fit" Click="StepFit_Click" ToolTip="Fit the complete part to the viewer and orbit around its center" />
                                    <TextBlock Text="Display" VerticalAlignment="Center" Margin="10,0,5,0" />
                                    <ComboBox x:Name="StepDisplayModeCombo" Width="130" SelectedIndex="0" IsEnabled="False"
                                              ToolTip="Choose shaded faces, shaded faces with visible edges, or wireframe">
                                        <ComboBoxItem Content="Shaded" Tag="shaded" />
                                        <ComboBoxItem Content="Visible edges" Tag="visibleEdges" />
                                        <ComboBoxItem Content="Wireframe" Tag="wireframe" />
                                    </ComboBox>
                                    <CheckBox x:Name="StepBoundingBoxToggle" Content="Show bounding box"
                                              IsChecked="False" IsEnabled="False" VerticalAlignment="Center" Margin="10,0,0,0"
                                              Checked="StepBoundingBox_Changed" Unchecked="StepBoundingBox_Changed"
                                              ToolTip="Show the model-coordinate bounding box only when requested" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="#C7D1DB" BorderThickness="1" CornerRadius="4">
                                    <views:StepViewerControl x:Name="StepViewer" />
                                </Border>
                                <Border Grid.Column="1" Margin="8,0,0,0" Padding="12" BorderBrush="#C7D1DB"
                                        BorderThickness="1" CornerRadius="4" Background="#F7F9FB">
                                    <StackPanel>
                                        <TextBlock Text="Measure toolbox" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Margin="0,4,0,12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="Measure a straight distance between two STEP vertices." />
                                        <Button Content="Distance (two points)" Click="StepMeasureDistance_Click" Margin="0,0,0,6" />
                                        <Button Content="Clear measurement" Click="StepClearMeasurement_Click" Margin="0,0,0,12" />
                                        <Border Padding="8" Background="#EAF0F5" CornerRadius="3">
                                            <TextBlock x:Name="StepMeasurementText" TextWrapping="Wrap"
                                                       Text="Select Distance, then click two model vertices." />
                                        </Border>
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="Values use the coordinate units stored by the STEP model. A and B stay attached while rotating or zooming." />
                                        <Separator Margin="0,12" />
                                        <TextBlock Text="Bounding box / reference" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="The orange wire box uses Model XYZ by default. For a custom reference, click three base-plane vertices and then two direction vertices." />
                                        <Button Content="Base face + direction edge" Click="StepReferenceFace_Click" Margin="0,0,0,6" />
                                        <Button Content="3 base points + 2 direction points" Click="StepReferencePoints_Click" Margin="0,0,0,6" />
                                        <WrapPanel><Button Content="Flip X" Click="StepFlipX_Click" /><Button Content="Flip Y" Click="StepFlipY_Click" /><Button Content="Flip Z" Click="StepFlipZ_Click" /><Button Content="Clear reference" Click="StepReferenceClear_Click" Margin="0" /></WrapPanel>
                                        <Border Padding="8" Margin="0,8,0,0" Background="#FFF2D9" CornerRadius="3">
                                            <TextBlock x:Name="StepBoundingBoxText" TextWrapping="Wrap" Text="Open a STEP model to calculate its bounding box." />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="The shaded part fits once when opened and then keeps its camera scale while rotating. Drag to rotate, use the mouse wheel to zoom, and select Fit to reset the camera framing. Edges and the bounding box are optional. Snapshot saves a PNG and places its path in the Case picture field; press Save Case to commit that change." />
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem ToolTip="View and manage the Case route Operations">
                        <TabItem.Style>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsParentCase}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource OperationsButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Operations" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                        <ScrollViewer x:Name="OperationsTabScroll" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Delete Selected" Click="DeleteOperation_Click" IsEnabled="{Binding CanDelete}" />
                                    <Button Content="Edit Selected" Command="{Binding BeginEditOperationCommand}" />
                                    <Button Command="{Binding BeginCreateOperationCommand}" Style="{StaticResource TemplateIconButton}"
                                            ToolTip="Add Operation" AutomationProperties.Name="Add Operation" Margin="0">
                                        <Image Source="{StaticResource OperationsButtonIcon}" Width="24" Height="24" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Ordered route template. New operations append to the route."
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" Background="#F6F8FA"
                                    BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreatingOperation}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding OperationFormHeading}" FontWeight="Bold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Operation Number" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationNumber}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationName}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Required Machine Type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OperationMachineTypeOptions}" SelectedItem="{Binding NewOperationRequiredMachineType}" MinHeight="38" Padding="7"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Dependency Type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OperationDependencyTypes}" SelectedItem="{Binding NewOperationDependencyType}" MinHeight="38" Padding="7"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Fixture Setup Time (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationSetupTime}" ToolTip="Machine occupancy for installing the fixture. Prepared-tool loading and first-piece prove-out are estimated separately."/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Cycle Time / Part (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationCycleTimePerPart}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="QA After Setup (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationQaTime}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Load / Unload per Event (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationLoadUnloadTime}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Automatic Loading: Every N Parts" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationLoadUnloadEveryNParts}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}" Margin="0,20,12,8"><CheckBox Content="Load/unload requires regular worker" IsChecked="{Binding NewOperationLoadUnloadRequiresWorker}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}" Margin="0,20,12,8"><CheckBox Content="Automatic loading" IsChecked="{Binding NewOperationAutomaticLoading}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}" Margin="0,20,12,8"><CheckBox Content="Day shift only" ToolTip="Uses the Server-configured local day-shift window." IsChecked="{Binding NewOperationDayShiftOnly}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Referenced Operation" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OperationReferenceOptions}" SelectedItem="{Binding NewOperationPredecessor}" DisplayMemberPath="DisplayName" MinHeight="38" Padding="7"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Simultaneous Group Key" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationSimultaneousGroupKey}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}" Margin="0,20,12,8"><CheckBox Content="External delay after operation" IsChecked="{Binding NewOperationHasExternalDelay}" ToolTip="Delays the next dependent operation without reserving this Machine." /></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="External process description" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationExternalDelayDescription}" /></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="External delay duration" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationExternalDelayDuration}" /></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Delay unit" Style="{StaticResource FieldLabel}"/><ComboBox SelectedValue="{Binding NewOperationExternalDelayDurationUnit}" SelectedValuePath="Tag"><ComboBoxItem Content="Hours" Tag="hours"/><ComboBoxItem Content="Calendar days" Tag="days"/><ComboBoxItem Content="Working days" Tag="working_days"/></ComboBox></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="External delay calendar" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding WorkingCalendars}" DisplayMemberPath="Name" SelectedValuePath="WorkingCalendarId" SelectedValue="{Binding NewOperationExternalDelayCalendarId}" ToolTip="All active Working Calendars, including the Israel Master Calendar, are available." /></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}" Margin="0,20,12,8"><CheckBox Content="Respect Israel Master Calendar" IsChecked="{Binding NewOperationRespectMasterCalendar}" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="INDEPENDENT uses no referenced operation. SEQUENTIAL and PARALLEL_CAPABLE require one. LOCKED_SIMULTANEOUS also requires a group key. The Server validates the complete dependency graph."
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                    <DockPanel>
                                        <TextBlock Text="Saving requires active Server-issued Edit Mode." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Cancel" Command="{Binding CancelCreateOperationCommand}" />
                                            <Button Content="{Binding OperationSaveButtonText}" Command="{Binding CreateOperationCommand}" Margin="0" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="220" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Route" Binding="{Binding RouteDisplayPosition}" Width="55" />
                                    <DataGridTextColumn Header="#" Binding="{Binding OperationNumber}" Width="55" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Machine type" Binding="{Binding RequiredMachineType}" Width="*" />
                                    <DataGridTextColumn Header="Dependency" Binding="{Binding DependencyType}" Width="*" />
                                    <DataGridTextColumn Header="Setup (HH:mm:ss)" Binding="{Binding SetupTimeDisplay}" Width="120" />
                                    <DataGridTextColumn Header="Cycle (HH:mm:ss)" Binding="{Binding CycleTimePerPartDisplay}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="3" Margin="0,14,0,0" Padding="14" Background="#F6F8FA"
                                    BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Refresh G-code" Command="{Binding RefreshGCodeCommand}" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Released G-code" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ActiveProcessRevisionText}" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="Select an Operation above to manage its released production artifacts. Meimad has no Draft G-code state."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <TextBlock Text="Postprocessor status (display only)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <DataGrid ItemsSource="{Binding GCodePostprocessors}"
                                              AutoGenerateColumns="False" IsReadOnly="True" IsHitTestVisible="False" Focusable="False"
                                              CanUserAddRows="False" MinHeight="100" MaxHeight="190">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Postprocessor" Binding="{Binding PostprocessorName}" Width="*"/>
                                            <DataGridTextColumn Header="Active process status" Binding="{Binding StatusText}" Width="220"/>
                                            <DataGridTextColumn Header="Current file" Binding="{Binding CurrentRelease.OriginalFileName}" Width="180"/>
                                            <DataGridTextColumn Header="Post revision" Binding="{Binding CurrentRelease.PostSpecificRevision}" Width="90"/>
                                            <DataGridTextColumn Header="Released by" Binding="{Binding CurrentRelease.ReleasedBy}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Release G-code" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                    <TextBlock Text="The source NC template must contain exactly one standalone [[MEIMAD:VERIFICATION_HOOK]] before its first executable block. Release does not require or validate a G65 P... call; the Server inserts the configured verification call only when it builds a Machine-specific Production Package."
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Style="{StaticResource FormField}">
                                            <TextBlock Text="Postprocessor" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding GCodePostprocessors}" SelectedItem="{Binding SelectedReleasePostprocessor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="PostprocessorName"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormField}">
                                            <TextBlock Text="Change scope" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding GCodeChangeScopes}" SelectedItem="{Binding GCodeChangeScope}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormField}">
                                            <TextBlock Text="Released G-code file" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGCode_Click" Margin="6,0,0,0"/><TextBox Text="{Binding GCodeFilePath}" IsReadOnly="True"/></DockPanel>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormField}" IsEnabled="{Binding IsNewProcessRevisionRelease}">
                                            <TextBlock Text="Tool-table file" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseToolTable_Click" Margin="6,0,0,0"/><TextBox Text="{Binding ToolTableFilePath}" IsReadOnly="True"/></DockPanel>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormField}">
                                            <TextBlock Text="Release comment" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GCodeReleaseComment}" AcceptsReturn="True" MinHeight="55"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormField}">
                                            <TextBlock Text="Process change description" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding ProcessChangeDescription}" AcceptsReturn="True" MinHeight="55"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock FontWeight="Bold" FontSize="16" Margin="0,4,0,8">
                                        <Run Text="Release target: "/><Run Text="{Binding SelectedReleasePostprocessor.PostprocessorName}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding NewProcessRevisionWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,8"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <CheckBox Content="Reuse the active physical tool table" IsChecked="{Binding ReuseActiveToolTable}" IsEnabled="{Binding IsNewProcessRevisionRelease}" Margin="0,0,18,6"/>
                                        <CheckBox Content="I confirm this exact physical tool table" IsChecked="{Binding ConfirmToolTable}" Margin="0,0,18,6"/>
                                        <CheckBox Content="I confirm creation of a new manufacturing-process revision" IsChecked="{Binding ConfirmNewProcessRevision}" Margin="0,0,18,6"/>
                                    </WrapPanel>
                                    <Button Content="Release G-code" Command="{Binding ReleaseGCodeCommand}" HorizontalAlignment="Right"/>

                                    <TextBlock Text="Process-revision history" FontWeight="SemiBold" Margin="0,14,0,5"/>
                                    <DataGrid ItemsSource="{Binding ProcessRevisions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessRevisionNumber}" Width="70"/>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding ChangeDescription}" Width="*"/>
                                            <DataGridTextColumn Header="Created by" Binding="{Binding CreatedBy}" Width="120"/>
                                            <DataGridTextColumn Header="Tool table" Binding="{Binding ToolTable.OriginalFileName}" Width="150"/>
                                            <DataGridTextColumn Header="Required tools" Binding="{Binding ToolTable.RequiredToolCount}" Width="95"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding ActiveToolTableSummary}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                    <DataGrid ItemsSource="{Binding ActiveReleasedTools}" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" MaxHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tool" Binding="{Binding ToolIdentifier}" Width="100"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                            <DataGridTextColumn Header="Requirement" Binding="{Binding RequirementText}" Width="170"/>
                                            <DataGridTextColumn Header="Magazine position" Binding="{Binding MagazinePosition}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Local post-revision history" FontWeight="SemiBold" Margin="0,14,0,5"/>
                                    <DataGrid ItemsSource="{Binding GCodeReleases}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="190">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessRevisionNumber}" Width="70"/>
                                            <DataGridTextColumn Header="Postprocessor" Binding="{Binding PostprocessorName}" Width="130"/>
                                            <DataGridTextColumn Header="Post rev" Binding="{Binding PostSpecificRevision}" Width="70"/>
                                            <DataGridTextColumn Header="Original filename" Binding="{Binding OriginalFileName}" Width="180"/>
                                            <DataGridTextColumn Header="Header Part" Binding="{Binding HeaderPartName}" Width="150"/>
                                            <DataGridTextColumn Header="Verification identity" Binding="{Binding VerificationHookSummary}" Width="260"/>
                                            <DataGridTextColumn Header="SHA-256" Binding="{Binding ShortHash}" Width="110"/>
                                            <DataGridTemplateColumn Header="Calculated cycle / part" Width="230">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding NcCalculatedTimeSummary}"
                                                                   ToolTip="{Binding NcCalculatedTimeDetail}"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Released by" Binding="{Binding ReleasedBy}" Width="110"/>
                                            <DataGridTextColumn Header="Comment" Binding="{Binding ReleaseComment}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Components" ToolTip="Case components, where-used relationships, and derived demand">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18">
                                <TextBlock Text="Components / Sub-Cases" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Quantity is required per one parent Case. Imported child Cases do not receive automatic Orders or Batches."
                                           Foreground="#667085" Margin="0,4,0,12" TextWrapping="Wrap" />
                                <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="150">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Child Part Number" Binding="{Binding ChildPartNumber}" Width="180" />
                                        <DataGridTextColumn Header="Child Case Name" Binding="{Binding ChildCaseName}" Width="*" />
                                        <DataGridTextColumn Header="Qty / Parent" Binding="{Binding QuantityPerParent}" Width="110" />
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="180" />
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Margin="0,12,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ComponentCaseOptions}"
                                              SelectedItem="{Binding SelectedComponentCase}" DisplayMemberPath="PartNumber"
                                              IsEnabled="{Binding CanEditForm}" ToolTip="Select an existing Case as the child component" />
                                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding ComponentQuantityPerParent, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsFormReadOnly}" ToolTip="Quantity per one parent" />
                                    <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding ComponentNotes, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsFormReadOnly}" ToolTip="Optional relationship notes" />
                                    <Button Grid.Column="3" Margin="8,0,0,0" Content="Add / Save" Command="{Binding SaveComponentCommand}" />
                                    <Button Grid.Column="4" Margin="8,0,0,0" Content="Deactivate" Command="{Binding RemoveComponentCommand}" />
                                </Grid>

                                <TextBlock Text="Where Used" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding WhereUsed}" SelectedItem="{Binding SelectedWhereUsed}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" MinHeight="110">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parent Part Number" Binding="{Binding ParentPartNumber}" Width="180" />
                                        <DataGridTextColumn Header="Parent Case Name" Binding="{Binding ParentCaseName}" Width="*" />
                                        <DataGridTextColumn Header="Qty / Parent" Binding="{Binding QuantityPerParent}" Width="110" />
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Open Case" Command="{Binding OpenParentCaseCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                        ToolTip="Open the selected parent Case" />

                                <TextBlock Text="Component Demand Preview" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Parent quantity" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Width="100" Text="{Binding ComponentDemandQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Margin="8,0,0,0" Content="Show demand" Command="{Binding PreviewComponentDemandCommand}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding ComponentDemand}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" MinHeight="130">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="65" />
                                        <DataGridTextColumn Header="Child Part Number" Binding="{Binding ChildPartNumber}" Width="180" />
                                        <DataGridTextColumn Header="Qty / Parent" Binding="{Binding QuantityPerParent}" Width="110" />
                                        <DataGridTextColumn Header="Total Required" Binding="{Binding TotalRequiredQuantity}" Width="120" />
                                        <DataGridTextColumn Header="Path" Binding="{Binding PathDisplay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem ToolTip="View and manage Orders for this Case">
                        <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource OrdersButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Orders" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                        <ScrollViewer x:Name="OrdersTabScroll" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanManageDirectOrders}">
                                    <Button Content="Delete Selected" Click="DeleteOrder_Click" IsEnabled="{Binding CanDeleteOrder}" />
                                    <Button Content="Edit Selected" Command="{Binding BeginEditOrderCommand}" />
                                    <Button Command="{Binding BeginCreateOrderCommand}" Style="{StaticResource TemplateIconButton}"
                                            ToolTip="Add Order" AutomationProperties.Name="Add Order" Margin="0">
                                        <Image Source="{StaticResource OrdersButtonIcon}" Width="24" Height="24" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding OrderListAuthorityText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" Background="#F6F8FA"
                                    BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreatingOrder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding OrderFormHeading}" FontWeight="Bold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Order Number" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOrderNumber}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOrderQuantity}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Work Finish Date (YYYY-MM-DD)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOrderWorkFinishDate}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Status" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OrderStatuses}" SelectedItem="{Binding NewOrderStatus}" MinHeight="38" Padding="7"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Price" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOrderPrice}"/></StackPanel>
                                    </UniformGrid>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOrderNotes}" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/></StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding OrderAuthorityText}" Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Cancel" Command="{Binding CancelCreateOrderCommand}" />
                                            <Button Content="{Binding OrderSaveButtonText}" Command="{Binding CreateOrderCommand}" Margin="0" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                                      IsEnabled="{Binding IsOrderListEnabled}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      MinHeight="220" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="*" />
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90" />
                                    <DataGridTextColumn Header="Work Finish Date" Binding="{Binding WorkFinishDate}" Width="140" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="100" />
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                <TextBlock Text="Parent-derived Orders (read-only)" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="These are projections of parent demand through component quantity. Create child Production Batches from the remaining quantity; no duplicate Order is created."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <DataGrid ItemsSource="{Binding DerivedOrders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parent Order" Binding="{Binding SourceOrderNumber}" Width="140" />
                                        <DataGridTextColumn Header="Parent Part" Binding="{Binding SourceParentPartNumber}" Width="130" />
                                        <DataGridTextColumn Header="Multiplier" Binding="{Binding QuantityPerParent}" Width="90" />
                                        <DataGridTextColumn Header="Derived" Binding="{Binding DerivedQuantity}" Width="90" />
                                        <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedQuantity}" Width="90" />
                                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity}" Width="90" />
                                        <DataGridTextColumn Header="Finish" Binding="{Binding WorkFinishDate}" Width="105" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                        <DataGridTextColumn Header="Path" Binding="{Binding PathDisplay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Batches">
                        <TabItem.Style>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding CanShowBatches}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <ScrollViewer x:Name="BatchesTabScroll" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Delete Selected" Click="DeleteBatch_Click" IsEnabled="{Binding CanDelete}" />
                                    <Button Content="Edit Selected" Command="{Binding BeginEditBatchCommand}" />
                                    <Button Content="Cancel production" Click="CancelBatchProduction_Click"
                                            IsEnabled="{Binding CanCancelBatchProduction}"
                                            ToolTip="Cancel this Batch, release active production resources, and reset Done parts to zero." />
                                    <Button Content="Add Production Batch" Command="{Binding BeginCreateBatchCommand}" Margin="0"
                                            ToolTip="Requires at least one defined Case Operation; the Server never invents a route." />
                                </StackPanel>
                                <TextBlock Text="Standalone and child production launches use direct or parent-derived demand, stock, and scrap allocations."
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" Background="#F6F8FA"
                                    BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4" MaxHeight="390">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreatingBatch}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Visible">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BatchFormHeading}" FontWeight="Bold" Margin="0,0,0,10" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewBatchNumber}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Planned Quantity" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewBatchPlannedQuantity}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Stock Quantity" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewBatchStockQuantity}"/></StackPanel>
                                            <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Scrap Allowance" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewBatchScrapAllowance}"/></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Order allocations (enter zero or leave blank to omit)" Style="{StaticResource FieldLabel}" />
                                        <DataGrid ItemsSource="{Binding BatchOrderAllocations}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="105" MaxHeight="170" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" IsReadOnly="True" Width="*" />
                                                <DataGridTextColumn Header="Demand" Binding="{Binding DemandQuantity}" IsReadOnly="True" Width="90" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="100" />
                                                <DataGridTextColumn Header="Allocate" Binding="{Binding AllocatedQuantity, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="The Server validates that planned quantity equals all allocations and instantiates Batch Operations from the current Case route."
                                                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                        <DockPanel>
                                            <TextBlock Text="Status and instantiated route remain Server-owned." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Cancel" Command="{Binding CancelCreateBatchCommand}" />
                                                <Button Content="{Binding BatchSaveButtonText}" Command="{Binding CreateBatchCommand}" Margin="0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="220" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="120" />
                                    <DataGridTextColumn Header="Planned quantity" Binding="{Binding PlannedQuantity}" Width="130" />
                                    <DataGridTextColumn Header="Operations" Binding="{Binding BatchOperationCount}" Width="100" />
                                    <DataGridTextColumn Header="Route revision" Binding="{Binding RouteRevision}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="3" Padding="12" Margin="0,10,0,0" Background="#F6F8FA"
                                    BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Refresh material" Command="{Binding RefreshBatchMaterialCommand}"/>
                                            <Button Content="Apply explicit reservations" Command="{Binding SaveMaterialReservationsCommand}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Material reconciliation" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding BatchMaterialState}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding BatchMaterialMessage}" TextWrapping="Wrap" Margin="0,7,0,8"/>
                                    <TextBlock Text="Only locally verified receipts appear here. Historical Kitaron approvals never create trusted availability. Enter exactly how many pieces this Batch reserves from each receipt."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding MaterialReceiptReservations}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" MinHeight="90" MaxHeight="170" Margin="0,0,0,10">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat={}{0:yyyy-MM-dd}}" IsReadOnly="True" Width="105"/>
                                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceDisplay}" IsReadOnly="True" Width="*"/>
                                            <DataGridTextColumn Header="Verified" Binding="{Binding Quantity}" IsReadOnly="True" Width="80"/>
                                            <DataGridTextColumn Header="Reserved elsewhere" Binding="{Binding ReservedElsewhere}" IsReadOnly="True" Width="115"/>
                                            <DataGridTextColumn Header="Available here" Binding="{Binding AvailableToThisBatch}" IsReadOnly="True" Width="95"/>
                                            <DataGridTextColumn Header="Reserve for Batch" Binding="{Binding ReserveQuantity, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Record a new physically verified receipt" Style="{StaticResource FieldLabel}"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Pieces" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaterialReceiptQuantity}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Receipt / lot reference" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaterialReceiptReference}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Verification note" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaterialReceiptComment}"/></StackPanel>
                                    </UniformGrid>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Record verified receipt" Command="{Binding RecordMaterialReceiptCommand}"/>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="If material is short: edit this Batch and its explicit allocations to reduce quantity; create a second Batch for a ready/waiting split; or keep the full quantity and wait. Quantity edits recalculate the timeline and readiness."/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Column="2" Background="#F6F7F9" BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasForm}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Select a Case" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Case form, Operations, Orders, and Batches will appear here."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
