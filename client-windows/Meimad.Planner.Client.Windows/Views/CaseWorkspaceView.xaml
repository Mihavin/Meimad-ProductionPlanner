                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="Inspection, deburring, packing, plating and similar steps run on Workstations, External Resources or Employees before or after the Machine. The Server places them automatically around the Machine anchor on the Timeline; the planner can pin a step there. Steps from Kitaron follow the station decisions in Setup."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding Requirements}" SelectedItem="{Binding SelectedRequirement}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="220">
