<UserControl x:Class="Meimad.Planner.Client.Windows.Views.CaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Meimad.Planner.Client.Windows.Views"
             MinHeight="560">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FormField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="#D8DDE3"
            BorderThickness="1"
            CornerRadius="5"
            Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="CASE POOL" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Part masters from the Server" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,9" />
                    <TextBlock Text="Search Part Number, name, or customer" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Customer filter" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Active state" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ActiveFilters}"
                                      SelectedItem="{Binding ActiveFilter}"
                                      MinHeight="38"
                                      Padding="7" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Sort Cases by" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding CaseSortOptions}"
                                  SelectedItem="{Binding CaseSort}"
                                  MinHeight="38"
                                  Padding="7" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
                        <Button Command="{Binding SearchCommand}" Style="{StaticResource TemplateIconButton}"
                                ToolTip="Search Cases" AutomationProperties.Name="Search Cases">
                            <Image Source="{StaticResource SearchButtonIcon}" Width="24" Height="24" />
                        </Button>
                        <Button Content="Clear" Command="{Binding ClearFiltersCommand}" />
                        <Button Content="Add Case" Command="{Binding BeginCreateCommand}" Margin="0" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="CasePoolList" Grid.Row="2"
                         ItemsSource="{Binding Cases}"
                         SelectedItem="{Binding SelectedCase}"
                         BorderBrush="#D8DDE3"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="7" Margin="1" BorderBrush="#E2E6EA" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="9" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="68" Height="52" Background="#EEF1F4" BorderBrush="#D4D9DE" BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            <TextBlock Text="No preview" FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PartNumber}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Customer}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ActiveStateText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasForm}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Delete Case" Click="DeleteCase_Click" IsEnabled="{Binding CanDeleteCase}" />
                        <Button Content="Open Working Folder" Command="{Binding OpenWorkingFolderCommand}" />
                        <Button Content="Refresh Case" Command="{Binding RefreshDetailsCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding FormHeading}" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding PartNumber}" FontSize="22" FontWeight="Bold" />
                            <Border Background="#E8EEF4" CornerRadius="3" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ActiveStateText}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TabControl Grid.Row="1">
                    <TabItem Header="Case form">
                        <ScrollViewer x:Name="CaseEditScroll"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Padding="14">
                            <StackPanel>
                                <Border Background="#FFF4CE" BorderBrush="#D6B656" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding CaseAuthorityText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </Border>
                                <Border Height="120" Background="#EEF1F4" BorderBrush="#D4D9DE" BorderThickness="1" Margin="0,0,0,10">
                                    <Grid>
                                        <Image Source="{Binding DetailPreview}" Stretch="Uniform" />
                                        <TextBlock Text="No preview" Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <UniformGrid Columns="2">
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Part Number" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PartNumber}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Revision" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Revision}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Customer" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Customer}" IsReadOnly="{Binding IsFormReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Customer Reference" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CustomerReference}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Material Type" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaterialType}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Material Specification" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaterialSpecification}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Raw Material Form" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RawMaterialForm}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Raw Material Dimensions" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RawMaterialDimensions}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Total Setup Time (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CurrentSetupTime, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" ToolTip="Read-only sum of setup time across all Case Operations."/></StackPanel>
                                    <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Total Cycle Time / Part (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CurrentCycleTimePerPart, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" ToolTip="Read-only sum of cycle time per part across all Case Operations."/></StackPanel>
                                </UniformGrid>
                                <StackPanel Style="{StaticResource FormField}">
                                    <TextBlock Text="Case Working Folder (external path)" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse Folder…" Click="BrowseFolder_Click"
                                                IsEnabled="{Binding CanEditUnlockedFields}" Margin="8,0,0,0" />
                                        <TextBox Text="{Binding WorkingFolderPath}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormField}">
                                    <TextBlock Text="Picture Path (server-readable path only)" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse Picture…" Click="BrowsePicture_Click"
                                                IsEnabled="{Binding CanEditUnlockedFields}" Margin="8,0,0,0" />
                                        <TextBox Text="{Binding PreviewPath}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Notes}" IsReadOnly="{Binding IsUnlockedFieldsReadOnly}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"/></StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Saving requires active Server-issued Edit Mode." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Cancel New Case" Command="{Binding CancelCreateCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="3D Models" ToolTip="STEP and STL models linked to the Case: part, rest-material stock, fixtures — with measurement tools">
                        <ScrollViewer x:Name="StepTabScroll" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <Grid Margin="8" MinHeight="600">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Open in 3D window" Click="OpenModelWindow_Click"
                                            ToolTip="Open the linked models in a separate, larger window with the full measurement toolbox" />
                                    <Button Content="Preview file…" Click="OpenStep_Click"
                                            ToolTip="Preview any STEP or STL file without linking it to the Case" />
                                    <Button x:Name="SnapshotStepButton" Content="Snapshot and use as Case image"
                                            Click="SnapshotStep_Click" IsEnabled="False" Margin="0" />
                                </StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Isometric" Click="StepIsometric_Click" />
                                    <Button Content="Front" Click="StepFront_Click" />
                                    <Button Content="Top" Click="StepTop_Click" />
                                    <Button Content="Right" Click="StepRight_Click" />
                                    <Button Content="Fit" Click="StepFit_Click" ToolTip="Fit the complete part to the viewer and orbit around its center" />
                                    <TextBlock Text="Projection" VerticalAlignment="Center" Margin="10,0,5,0" />
                                    <ComboBox x:Name="StepProjectionCombo" Width="110" SelectedIndex="0" IsEnabled="False"
                                              SelectionChanged="StepProjection_SelectionChanged"
                                              ToolTip="Orthographic keeps parallel edges parallel; perspective shows depth like a photograph">
                                        <ComboBoxItem Content="Orthographic" Tag="orthographic" />
                                        <ComboBoxItem Content="Perspective" Tag="perspective" />
                                    </ComboBox>
                                    <TextBlock Text="Display" VerticalAlignment="Center" Margin="10,0,5,0" />
                                    <ComboBox x:Name="StepDisplayModeCombo" Width="140" SelectedIndex="0" IsEnabled="False"
                                              ToolTip="Shaded, shaded with visible edges, hidden line, wireframe, or transparent">
                                        <ComboBoxItem Content="Shaded" Tag="shaded" />
                                        <ComboBoxItem Content="Shaded with edges" Tag="visibleEdges" />
                                        <ComboBoxItem Content="Hidden line" Tag="hiddenLine" />
                                        <ComboBoxItem Content="Wireframe" Tag="wireframe" />
                                        <ComboBoxItem Content="Transparent" Tag="transparent" />
                                    </ComboBox>
                                    <CheckBox x:Name="StepBoundingBoxToggle" Content="Show bounding box"
                                              IsChecked="False" IsEnabled="False" VerticalAlignment="Center" Margin="10,0,0,0"
                                              Checked="StepBoundingBox_Changed" Unchecked="StepBoundingBox_Changed"
                                              ToolTip="Show the model-coordinate bounding box only when requested" />
                                </WrapPanel>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="#C7D1DB" BorderThickness="1" CornerRadius="4">
                                    <views:StepViewerControl x:Name="StepViewer" />
                                </Border>
                                <Border Grid.Column="1" Margin="8,0,0,0" Padding="12" BorderBrush="#C7D1DB"
                                        BorderThickness="1" CornerRadius="4" Background="#F7F9FB">
                                    <StackPanel>
                                        <TextBlock Text="Model files" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="STEP/STL files linked to this Case by path: the part model, rest-material stock, fixtures. The primary part model opens first." />
                                        <ListBox x:Name="ModelFilesList" ItemsSource="{Binding ModelFiles}" SelectedItem="{Binding SelectedModelFile}"
                                                 MaxHeight="160" BorderBrush="#C7D1DB" HorizontalContentAlignment="Stretch"
                                                 MouseDoubleClick="ModelFilesList_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PrimaryText}" Foreground="#1B6E3A"
                                                                       FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FilePath}" />
                                                        </DockPanel>
                                                        <TextBlock FontSize="11" Foreground="#5B6B7A">
                                                            <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormatText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{Binding ModelFilesStatus}" Margin="0,4,0,6" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <DockPanel Margin="0,0,0,6">
                                            <ComboBox x:Name="StepAddKindCombo" DockPanel.Dock="Left" Width="118" SelectedIndex="0"
                                                      IsEnabled="{Binding CanManageModelFiles}" Margin="0,0,6,0"
                                                      ToolTip="What the file represents">
                                                <ComboBoxItem Content="Part model" Tag="part" />
                                                <ComboBoxItem Content="Stock" Tag="stock" />
                                                <ComboBoxItem Content="Fixture" Tag="fixture" />
                                                <ComboBoxItem Content="Other" Tag="other" />
                                            </ComboBox>
                                            <Button Content="Add file…" Click="AddModelFile_Click" IsEnabled="{Binding CanManageModelFiles}" Margin="0"
                                                    ToolTip="Link a STEP or STL file to the Case" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Show all" Click="LoadModelFiles_Click" ToolTip="Load every linked file into the viewer" />
                                            <Button Content="Set primary" Click="SetPrimaryModelFile_Click" IsEnabled="{Binding CanManageModelFiles}" />
                                            <Button Content="Remove" Click="RemoveModelFile_Click" IsEnabled="{Binding CanManageModelFiles}" Margin="0"
                                                    ToolTip="Remove the link (the file on disk stays)" />
                                        </WrapPanel>
                                        <Separator Margin="0,4,0,10" />
                                        <TextBlock Text="Measure" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="Pick a tool, then click vertices, edges or faces. Esc cancels. Left-drag orbits, right-drag pans, wheel zooms." />
                                        <WrapPanel>
                                            <Button Content="Point" Click="StepTool_Click" Tag="point" ToolTip="Coordinates of a vertex" />
                                            <Button Content="Distance" Click="StepTool_Click" Tag="distance" ToolTip="Straight distance between two vertices" />
                                            <Button Content="Min. dist." Click="StepTool_Click" Tag="minimumDistance" ToolTip="Shortest distance between two vertices, edges or faces — also between models" />
                                            <Button Content="Edge" Click="StepTool_Click" Tag="edgeLength" ToolTip="Exact edge length" />
                                            <Button Content="Radius / Ø" Click="StepTool_Click" Tag="radius" ToolTip="Radius and diameter of a circular edge or round face" />
                                            <Button Content="Angle" Click="StepTool_Click" Tag="angle" ToolTip="Angle between edges or planar faces" />
                                            <Button Content="Area" Click="StepTool_Click" Tag="faceArea" ToolTip="Exact face area" />
                                            <Button Content="Volume" Click="StepTool_Click" Tag="volume" ToolTip="Volume, surface, centroid and bounding box" />
                                            <Button Content="Clear" Click="StepClearMeasurement_Click" Margin="0" ToolTip="Cancel the tool and remove every measurement" />
                                        </WrapPanel>
                                        <Border Padding="8" Margin="0,6,0,0" Background="#EAF0F5" CornerRadius="3">
                                            <TextBlock x:Name="StepMeasurementText" TextWrapping="Wrap"
                                                       Text="Select a measurement tool." />
                                        </Border>
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="STEP values are exact OpenCascade geometry in millimetres; STL meshes support point, distance and volume tools. Measurements stay attached while rotating or zooming." />
                                        <Separator Margin="0,12" />
                                        <TextBlock Text="Bounding box / reference" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                   Text="The orange wire box uses Model XYZ by default. For a custom reference, click three base-plane vertices and then two direction vertices." />
                                        <Button Content="Base face + direction edge" Click="StepReferenceFace_Click" Margin="0,0,0,6" />
                                        <Button Content="3 base points + 2 direction points" Click="StepReferencePoints_Click" Margin="0,0,0,6" />
                                        <WrapPanel><Button Content="Flip X" Click="StepFlipX_Click" /><Button Content="Flip Y" Click="StepFlipY_Click" /><Button Content="Flip Z" Click="StepFlipZ_Click" /><Button Content="Clear reference" Click="StepReferenceClear_Click" Margin="0" /></WrapPanel>
                                        <Border Padding="8" Margin="0,8,0,0" Background="#FFF2D9" CornerRadius="3">
                                            <TextBlock x:Name="StepBoundingBoxText" TextWrapping="Wrap" Text="Open a STEP model to calculate its bounding box." />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="Linked model files load automatically when the Case is selected (primary part model first; stock and fixtures are drawn translucent). Left-drag rotates, right-drag pans, the wheel zooms, and Fit resets the framing. Snapshot saves a PNG and places its path in the Case picture field; press Save Case to commit that change." />
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem ToolTip="View and manage the Case route Operations">
                        <TabItem.Style>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsParentCase}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource OperationsButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Operations" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                        <ScrollViewer x:Name="OperationsTabScroll" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Delete Selected" Click="DeleteOperation_Click" IsEnabled="{Binding CanDelete}" />
                                    <Button Content="Edit Selected" Command="{Binding BeginEditOperationCommand}" />
                                    <Button Command="{Binding BeginCreateOperationCommand}" Style="{StaticResource TemplateIconButton}"
                                            ToolTip="Add Operation" AutomationProperties.Name="Add Operation" Margin="0">
                                        <Image Source="{StaticResource OperationsButtonIcon}" Width="24" Height="24" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Ordered route template. New operations append to the route."
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" Background="#F6F8FA"
                                    BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreatingOperation}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding OperationFormHeading}" FontWeight="Bold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Operation Number" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationNumber}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationName}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Required Machine Type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OperationMachineTypeOptions}" SelectedItem="{Binding NewOperationRequiredMachineType}" MinHeight="38" Padding="7"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Dependency Type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OperationDependencyTypes}" SelectedItem="{Binding NewOperationDependencyType}" MinHeight="38" Padding="7"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Fixture Setup Time (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationSetupTime}" ToolTip="Machine occupancy for installing the fixture. Prepared-tool loading and first-piece prove-out are estimated separately."/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Cycle Time / Part (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationCycleTimePerPart}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="QA After Setup (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationQaTime}"/></StackPanel>
                                        <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Load / Unload per Event (HH:mm:ss)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewOperationLoadUnloadTime}"/></StackPanel>
