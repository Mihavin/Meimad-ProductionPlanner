                                    <Border Padding="12" Margin="0,10,0,0" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="4"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EditorHeading}" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <UniformGrid Columns="3">
                                                <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Step name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name}"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Step number" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StepNumber}"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Resource class" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ResourceClassOptions}" SelectedItem="{Binding ResourceClass}"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}" Visibility="{Binding IsWorkstationClass, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Workstation type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding WorkstationTypes}" SelectedItem="{Binding SelectedWorkstationType}" DisplayMemberPath="DisplayName"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}" Visibility="{Binding IsWorkstationClass, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Required capability (optional)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CapabilityText}"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}" Visibility="{Binding IsExternalClass, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="External Resource" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ExternalResources}" SelectedItem="{Binding SelectedExternalResource}" DisplayMemberPath="Name"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}" Visibility="{Binding IsEmployeeClass, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Required Skill" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}" DisplayMemberPath="DisplayName"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Before or after the Machine" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding Direction}"/></StackPanel>
                                                <StackPanel Style="{StaticResource FormField}"><TextBlock Text="Capacity required" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Capacity}"/></StackPanel>
