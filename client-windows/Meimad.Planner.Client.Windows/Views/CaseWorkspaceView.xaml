                                            <DataGridTextColumn Header="Min / part" Binding="{Binding PerPartText}" Width="80"/>
                                            <DataGridTextColumn Header="After step" Binding="{Binding PredecessorText}" Width="*"/>
                                            <DataGridTextColumn Header="Origin" Binding="{Binding OriginLabel}" Width="70"/>
                                            <DataGridTextColumn Header="State" Binding="{Binding ActiveLabel}" Width="70"/>
