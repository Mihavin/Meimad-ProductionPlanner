                    <TabItem ToolTip="View and manage Orders for this Case">
                        <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource OrdersButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Orders" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
