<UserControl x:Class="Meimad.Planner.Client.Windows.Views.MachineUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Meimad.Planner.Client.Windows.Views"
             Background="{StaticResource CanvasBrush}">
  <UserControl.Resources>
    <Style x:Key="Kpi" TargetType="Border">
      <Setter Property="BorderBrush" Value="#BBBBBB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinWidth" Value="140" />
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LegendSwatch" TargetType="Border">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="BorderBrush" Value="#555555" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="220" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="Calculate" Command="{Binding CalculateCommand}" Margin="0,0,8,0" />
        <Button Content="Print report" Command="{Binding PrintReportCommand}" Margin="0,0,8,0"
                ToolTip="Open the report as a printable page with the history charts; print it or save it as PDF" />
        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                ToolTip="Every machine and day in hours and percent, for Excel" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Machine Usage" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="How each machine's available time was spent, from what was recorded: production (CNC running state, or reported production sessions), setup (Offset Loader or reported setup run to Send to QC), downtime, no CNC data, and idle. Usage is production plus setup over the available time."
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
      <DatePicker SelectedDate="{Binding From}" Width="130" Margin="0,0,14,0" />
      <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,6,0" />
      <DatePicker SelectedDate="{Binding To}" Width="130" Margin="0,0,14,0" />
      <TextBlock Text="Available time" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox ItemsSource="{Binding BasisOptions}" SelectedItem="{Binding Basis}" Width="190"
                ToolTip="Working calendar: each machine's shifts, breaks and holidays as the Timeline uses them. Whole day: 24 hours a day." />
    </WrapPanel>

    <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}"
               TextWrapping="Wrap" Margin="0,0,0,8" />

    <StackPanel Grid.Row="3" Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="Overall performance" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
      <WrapPanel DataContext="{Binding Totals}">
        <Border Style="{StaticResource Kpi}">
          <StackPanel>
            <TextBlock Text="Usage" />
            <TextBlock Text="{Binding UsageText}" Style="{StaticResource KpiValue}" />
            <TextBlock><Run Text="{Binding UsedText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding AvailableText, Mode=OneWay}" /></TextBlock>
            <TextBlock Text="{Binding UsageLevelText}" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Kpi}">
          <StackPanel>
            <TextBlock Text="Production" />
            <TextBlock Text="{Binding ProductionText}" Style="{StaticResource KpiValue}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Kpi}">
          <StackPanel>
            <TextBlock Text="Total setup time" />
            <TextBlock Text="{Binding SetupText}" Style="{StaticResource KpiValue}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Kpi}">
          <StackPanel>
            <TextBlock Text="Total idle time" />
            <TextBlock Text="{Binding IdleText}" Style="{StaticResource KpiValue}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Kpi}">
          <StackPanel>
            <TextBlock Text="Downtime" />
            <TextBlock Text="{Binding DowntimeText}" Style="{StaticResource KpiValue}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Kpi}" ToolTip="Time a CNC-monitored machine sent no state (connection offline or state unknown)">
          <StackPanel>
            <TextBlock Text="No data" />
            <TextBlock Text="{Binding NoDataText}" Style="{StaticResource KpiValue}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Kpi}" ToolTip="Production and setup outside the available time, such as unattended running after the shift; not counted in the percentages">
          <StackPanel>
            <TextBlock Text="Outside schedule" />
            <TextBlock Text="{Binding OutsideScheduleText}" Style="{StaticResource KpiValue}" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>

    <DataGrid Grid.Row="4" ItemsSource="{Binding Machines}" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto" FrozenColumnCount="1" Margin="0,0,0,8"
              MaxHeight="300">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Machine" Binding="{Binding DisplayName}" Width="220" />
        <DataGridTextColumn Header="Data source" Binding="{Binding DataSourceText}" Width="120" />
        <DataGridTextColumn Header="Available time" Binding="{Binding Metrics.AvailableText}" Width="85" />
        <DataGridTextColumn Header="Usage" Binding="{Binding Metrics.UsageText}" Width="75" />
        <DataGridTextColumn Header="Level" Binding="{Binding Metrics.UsageLevelText}" Width="100" />
        <DataGridTextColumn Header="Used" Binding="{Binding Metrics.UsedText}" Width="75" />
        <DataGridTextColumn Header="Production" Binding="{Binding Metrics.ProductionText}" Width="130" />
        <DataGridTextColumn Header="Machine setup" Binding="{Binding Metrics.SetupText}" Width="130" />
        <DataGridTextColumn Header="Idle" Binding="{Binding Metrics.IdleText}" Width="130" />
        <DataGridTextColumn Header="Downtime" Binding="{Binding Metrics.DowntimeText}" Width="130" />
        <DataGridTextColumn Header="No data" Binding="{Binding Metrics.NoDataText}" Width="130" />
        <DataGridTextColumn Header="Outside schedule" Binding="{Binding Metrics.OutsideScheduleText}" Width="*" MinWidth="110" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="5" Margin="0,0,0,4">
      <TextBlock Text="Daily history" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
      <ComboBox ItemsSource="{Binding ChartScopes}" SelectedItem="{Binding ChartScope}" Width="240" Margin="0,0,16,0"
                ToolTip="Show every machine together, or one machine" />
      <WrapPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border Style="{StaticResource LegendSwatch}" Background="#1E88E5" /><TextBlock Text="Production" /></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border Style="{StaticResource LegendSwatch}" Background="#FBC02D" /><TextBlock Text="Machine setup" /></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border Style="{StaticResource LegendSwatch}" Background="#C62828" /><TextBlock Text="Downtime" /></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border Style="{StaticResource LegendSwatch}" Background="#9E9E9E" /><TextBlock Text="Idle" /></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border x:Name="NoDataSwatch" Style="{StaticResource LegendSwatch}" /><TextBlock Text="No data" /></StackPanel>
        <TextBlock Text="Usage % above each bar" Foreground="{StaticResource MutedTextBrush}" />
      </WrapPanel>
    </DockPanel>

    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="#BBBBBB" BorderThickness="1" Background="White" Margin="0,0,8,0">
        <views:MachineUsageHistoryChart Days="{Binding ChartDays}" Margin="4" />
      </Border>
      <DataGrid Grid.Column="1" ItemsSource="{Binding ChartDays}" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Day" Binding="{Binding DateText}" Width="Auto" MinWidth="80" />
          <DataGridTextColumn Header="Usage" Binding="{Binding Metrics.UsageText}" Width="Auto" MinWidth="60" />
          <DataGridTextColumn Header="Available time" Binding="{Binding Metrics.AvailableText}" Width="Auto" MinWidth="60" />
          <DataGridTextColumn Header="Production" Binding="{Binding Metrics.ProductionText}" Width="Auto" />
          <DataGridTextColumn Header="Machine setup" Binding="{Binding Metrics.SetupText}" Width="Auto" />
          <DataGridTextColumn Header="Idle" Binding="{Binding Metrics.IdleText}" Width="Auto" />
          <DataGridTextColumn Header="Downtime" Binding="{Binding Metrics.DowntimeText}" Width="Auto" />
          <DataGridTextColumn Header="No data" Binding="{Binding Metrics.NoDataText}" Width="Auto" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>
