                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip="Manage employees, roles, skills, and availability">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ResourcesButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Employees / Resources" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SetupSection}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Edit selected employee" Command="{Binding EditSelectedResourceCommand}"/><Button Content="New" Command="{Binding NewResourceCommand}" Margin="0"/></StackPanel><TextBlock Text="EMPLOYEES / RESOURCES" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee #" Binding="{Binding EmployeeNumber}" Width="95"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="115"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SetupSection}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsEditor}">
                            <TextBlock Text="{Binding ResourceFormHeading}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Employee number" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceEmployeeNumber}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="First name" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceFirstName}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Last name" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceLastName}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Role" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding ResourceRoles}" SelectedItem="{Binding ResourceRole}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Assigned calendar" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding ResourceCalendars}" SelectedItem="{Binding SelectedResourceCalendar}" DisplayMemberPath="DisplayName"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Email" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceEmail}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Photo path" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourcePhotoPath}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="SETUP SKILLS (applied when this setup worker is qualified for the assigned Machine)" Style="{StaticResource SetupFieldLabel}" Margin="0,8,0,2"/>
                            <UniformGrid Columns="3">
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Tool load sec/tool" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceToolLoadSecondsPerTool}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Fixture assembly sec" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceFixtureAssemblySeconds}" ToolTip="Leave blank to use the operation fixture setup time."/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="First part speed %" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceFirstPartRunningSpeedPercent}" ToolTip="100% equals the regular cycle time."/></StackPanel>
                            </UniformGrid>
                            <StackPanel Style="{StaticResource SetupField}">
                                <TextBlock Text="Machines this employee knows how to operate" Style="{StaticResource SetupFieldLabel}"/>
                                <Border BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="3" Padding="8" MinHeight="44" MaxHeight="150">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ResourceMachineSkills}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayName}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Text="Select every Machine this employee is qualified to operate. Machine IDs are stored so renaming a Machine does not remove the qualification."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Notes" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceNotes}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                            <CheckBox Content="Active" IsChecked="{Binding ResourceIsActive}" Margin="0,0,0,12"/>
                            <CheckBox Content="Respect Israel Master Calendar" IsChecked="{Binding ResourceRespectMasterCalendar}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal"><Button Content="{Binding ResourceSaveActionText}" Command="{Binding SaveResourceCommand}"/><Button Content="Delete" Click="DeleteResource_Click" Margin="0"/></StackPanel>
                            <TextBlock Text="Inactive employees are excluded from future resource availability. Employee capacity scheduling is not implemented." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Separator Margin="0,16,0,12"/>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh exceptions" Command="{Binding RefreshResourceExceptionsCommand}"/><Button Content="New exception" Command="{Binding NewResourceExceptionCommand}" Margin="0"/></StackPanel>
                                <TextBlock Text="EMPLOYEE CALENDAR EXCEPTIONS" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding ResourceExceptions}" SelectedItem="{Binding SelectedResourceException}" DisplayMemberPath="DisplayName" MinHeight="80" MaxHeight="150" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ResourceExceptionFormHeading}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Date (yyyy-MM-dd)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceExceptionDate}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Exception type" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding ResourceExceptionTypes}" SelectedItem="{Binding ResourceExceptionType}"/></StackPanel>
                            </UniformGrid>
                            <CheckBox Content="Full day" IsChecked="{Binding ResourceExceptionIsFullDay}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" IsEnabled="{Binding IsResourceExceptionPartialDay}">
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Start (HH:mm)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceExceptionStartsAt}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="End (HH:mm)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceExceptionEndsAt}"/></StackPanel>
                            </UniformGrid>
                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Note" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ResourceExceptionNote}" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Button Content="Save exception" Command="{Binding SaveResourceExceptionCommand}"/><Button Content="Delete exception" Click="DeleteResourceException_Click" Margin="0"/></StackPanel>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip="Manage holiday calendar availability">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource CalendarButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Israeli Holidays" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SetupSection}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="New" Command="{Binding NewIsraeliHolidayCommand}" Margin="8,0,0,0"/><TextBlock Text="ISRAELI HOLIDAY CALENDAR" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding IsraeliHolidays}" SelectedItem="{Binding SelectedIsraeliHoliday}" DisplayMemberPath="DisplayName"/>
                            <StackPanel Grid.Row="2" Margin="0,10,0,0" IsEnabled="{Binding IsEditor}">
                                <TextBlock Text="ONLINE REFRESH / LOCAL CACHE" Style="{StaticResource SetupFieldLabel}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="From year" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HolidaySyncFromYear}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="To year" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HolidaySyncToYear}"/></StackPanel>
                                </UniformGrid>
                                <Button Content="Refresh from Hebcal" Command="{Binding SynchronizeIsraeliHolidaysCommand}" HorizontalAlignment="Left"/>
                                <TextBlock Text="Holiday data provided by Hebcal.com (CC BY 4.0)." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding HolidaySyncStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SetupSection}">
                        <StackPanel IsEnabled="{Binding IsEditor}">
                            <TextBlock Text="{Binding IsraeliHolidayFormHeading}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Date (yyyy-MM-dd)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding IsraeliHolidayDate}"/></StackPanel>
                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Holiday name" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding IsraeliHolidayName}"/></StackPanel>
                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Availability policy" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding IsraeliHolidayStatuses}" SelectedItem="{Binding IsraeliHolidayStatus}"/></StackPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Partial day starts (HH:mm)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding IsraeliHolidayStartsAt}"/></StackPanel>
                                <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Partial day ends (HH:mm)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding IsraeliHolidayEndsAt}"/></StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal"><Button Content="Save holiday" Command="{Binding SaveIsraeliHolidayCommand}"/><Button Content="Delete" Click="DeleteIsraeliHoliday_Click" Margin="0"/></StackPanel>
                            <TextBlock Text="Manual edits are preserved during later online refreshes. Calendars that opt in use this local cache, including while offline. Calendar-specific dated exceptions take precedence." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip="Import planning data from an Excel workbook">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ImportButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Excel Case + Order Import" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <Grid Margin="8" FlowDirection="LeftToRight">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SetupSection}">
                        <StackPanel>
                            <TextBlock Text="Simple fixed-mapping Case and Order import" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Choose the Excel file and worksheet, preview the rows, then import. Valid rows create or match Cases by Part Number and create or match their Orders. Invalid rows are skipped with an explanation." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SetupSection}" Background="#F3F8FF" BorderBrush="#8BB8F8">
                        <StackPanel>
                            <TextBlock Text="Fixed mapping" FontSize="17" FontWeight="Bold" Foreground="#174A7E" />
                            <TextBlock Text="{Binding LegacyImport.FixedMappingSummary}" Foreground="#365B7D" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="Part Number is the Case key. Order uniqueness is Case + Order Number. Existing records are matched and are not silently overwritten." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource SetupSection}">
                            <StackPanel>
                                <TextBlock Text="Workbook and worksheet" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Select the worksheet containing columns A, B, D, E, F, L, N, and O. Preview is read-only; Import is the only write action." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource SetupField}"><TextBlock Text="Excel workbook" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding LegacyImport.SelectedFilePath}" IsReadOnly="True" ToolTip="The source workbook is read-only." /></StackPanel>
                                    <Button Grid.Column="1" Content="Browse..." Click="BrowseLegacyWorkbook_Click" Margin="8,20,0,8" />
                                    <StackPanel Grid.Column="2" Style="{StaticResource SetupField}" Margin="8,0,0,8"><TextBlock Text="Worksheet" Style="{StaticResource SetupFieldLabel}" /><ComboBox ItemsSource="{Binding LegacyImport.SheetChoices}" Text="{Binding LegacyImport.ImportSheetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" ToolTip="Select the worksheet that contains the defined import columns." /></StackPanel>
                                    <Button Grid.Column="3" Content="Preview data" Command="{Binding LegacyImport.PreviewDefinedImportCommand}" Margin="8,20,0,8" />
                                </Grid>
                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,2,0,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding LegacyImport.IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                                <TextBlock Text="{Binding LegacyImport.ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding LegacyImport.PreviewSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding LegacyImport.SimpleCaseOrderRows}" SelectedItem="{Binding LegacyImport.SelectedWizardRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Excel row" Binding="{Binding RowNumber}" Width="75" />
                                <DataGridTextColumn Header="Source data" Binding="{Binding SourceSummary}" Width="2.5*" />
                                <DataGridTextColumn Header="Case / Order result" Binding="{Binding DecisionDisplayName}" Width="1.5*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                <DataGridTextColumn Header="Explanation" Binding="{Binding AutomaticReason}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="4" Style="{StaticResource SetupSection}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding LegacyImport.SimpleCaseOrderPreviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding LegacyImport.CaseOrderImportAvailabilityText}" Foreground="#8A4B08" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding LegacyImport.ResultSummary}" Foreground="#20744A" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Import writes only Cases and Orders in one Server transaction. It never creates Batches, Operations, Machine assignments, backlog entries, or Timeline data." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                <Button Grid.Column="2" Content="Import Cases and Orders" Command="{Binding LegacyImport.ImportCasesAndOrdersCommand}" IsEnabled="{Binding LegacyImport.CanImportCasesAndOrders}" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <TabControl Grid.Row="4" Visibility="Collapsed" SelectedIndex="{Binding LegacyImport.WizardStep, Mode=OneWay}" TabStripPlacement="Top" ItemContainerStyle="{StaticResource WizardStepTabItem}">
                        <TabItem Header="1  Preview">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SetupSection}" Margin="0,8,0,0" MaxWidth="950" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="Choose the workbook" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="Preview identifies the planning sheet, open orders, columns, Machine sections, and matching candidates. It does not create Cases, Orders, Batches, or assignments." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource SetupField}"><TextBlock Text="Workbook path" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding LegacyImport.SelectedFilePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Choose a copy of the workbook. The original file is never modified." /></StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource SetupField}" Margin="8,0,0,8"><TextBlock Text="Planning sheet" Style="{StaticResource SetupFieldLabel}" /><ComboBox ItemsSource="{Binding LegacyImport.SheetChoices}" Text="{Binding LegacyImport.SourceSheetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" ToolTip="Choose a detected worksheet, then validate / refresh the preview." /><TextBlock Text="Open-orders sheet (optional)" Style="{StaticResource SetupFieldLabel}" Margin="0,5,0,0" /><ComboBox ItemsSource="{Binding LegacyImport.OptionalSheetChoices}" Text="{Binding LegacyImport.OpenOrdersSheetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" ToolTip="Leave blank when open Orders are not part of this import." /></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Browse…" Click="BrowseLegacyWorkbook_Click" Margin="8,0,0,0" /><Button Command="{Binding LegacyImport.PreviewCommand}" Style="{StaticResource TemplateIconButton}" ToolTip="Preview and validate the selected workbook" AutomationProperties.Name="Preview workbook" Margin="8,0,0,0"><Image Source="{StaticResource ImportButtonIcon}" Width="24" Height="24" /></Button></StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding LegacyImport.ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding LegacyImport.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding LegacyImport.PreviewCorrectionStatus}" Foreground="#996C00" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding LegacyImport.PreviewSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,8" />
                                    <DataGrid ItemsSource="{Binding LegacyImport.DetectedSheets}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Detected sheet" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Rows" Binding="{Binding RowCount}" Width="80" />
                                            <DataGridTextColumn Header="Columns" Binding="{Binding ColumnCount}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,5,0,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding LegacyImport.IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                                </StackPanel>
                            </Border></ScrollViewer>
                        </TabItem>

                        <TabItem Header="2  Import targets">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SetupSection}" Margin="0,8,0,0"><StackPanel IsEnabled="{Binding IsEditor}">
                                <TextBlock Text="Choose what to import" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Keep these targets explicit. You can import operations to the Pool, import Orders under Cases, and create Batches with Machine assignments. Unchecked targets are not mutated on commit." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource SetupSection}" Margin="0,0,8,0"><StackPanel><CheckBox Content="Create Batches in Pool" IsChecked="{Binding LegacyImport.ImportPoolBatches}" FontWeight="SemiBold" /><TextBlock Text="Clone the existing Case route into unassigned Batch Operations; no raw Excel operation or route is invented." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                                    <Border Style="{StaticResource SetupSection}" Margin="0,0,8,0"><StackPanel><CheckBox Content="Import Orders" IsChecked="{Binding LegacyImport.ImportOrders}" FontWeight="SemiBold" /><TextBlock Text="Create or match Orders and preserve quantity and Work Finish Date." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                                    <Border Style="{StaticResource SetupSection}"><StackPanel><CheckBox Content="Create Batches and assign Machines" IsChecked="{Binding LegacyImport.ImportMachineAssignments}" FontWeight="SemiBold" /><TextBlock Text="Select the route operation, allocate quantity, and choose an existing Machine per row." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                                </UniformGrid>
                                <TextBlock Text="{Binding LegacyImport.OutcomeSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding LegacyImport.ValidationSummary}" Foreground="#996C00" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LegacyImport.PreviewSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>

                        <TabItem Header="3  Columns &amp; Machines">
                            <Grid Margin="0,8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,8"><TextBlock Text="Confirm source columns and Machine sections" FontSize="16" FontWeight="Bold" /><TextBlock Text="Review suggestions and change only unclear mappings. Required fields must be resolved before commit; optional blank mappings are not sent." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /><WrapPanel Margin="0,6,0,0"><Button Content="Validate / refresh preview" Command="{Binding LegacyImport.PreviewCommand}" Margin="0,0,8,0" /><TextBlock Text="{Binding LegacyImport.PreviewCorrectionStatus}" Foreground="#996C00" TextWrapping="Wrap" VerticalAlignment="Center" /></WrapPanel></StackPanel>
                                <Grid Grid.Row="1" IsEnabled="{Binding IsEditor}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SetupSection}"><DataGrid ItemsSource="{Binding LegacyImport.IncludedMappings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding SourceHeader}" Width="1.2*" IsReadOnly="True" /><DataGridTextColumn Header="Sample" Binding="{Binding SampleValue}" Width="1.2*" IsReadOnly="True" /><DataGridTextColumn Header="Target" Binding="{Binding TargetField}" Width="1.3*" IsReadOnly="True" /><DataGridTemplateColumn Header="Source column" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding ColumnOptions}" SelectedValue="{Binding SourceColumn, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Column" DisplayMemberPath="DisplayName" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridCheckBoxColumn Header="Required" Binding="{Binding IsRequired, Mode=OneWay}" Width="65" IsReadOnly="True" /><DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="95" IsReadOnly="True" /></DataGrid.Columns></DataGrid></Border>
                                    <Border Grid.Column="2" Style="{StaticResource ImportMachineMappingsSection}"><StackPanel><TextBlock Text="Machine sections" FontWeight="Bold" Margin="0,0,0,8" /><TextBlock Text="{Binding LegacyImport.MachineSuggestionSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" /><Button Content="Accept clear Machine suggestions" Command="{Binding LegacyImport.AcceptClearMachineSuggestionsCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" /><DataGrid ItemsSource="{Binding LegacyImport.IncludedMachineMappings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Workbook section" Binding="{Binding SourceHeader}" Width="1.3*" IsReadOnly="True" /><DataGridTemplateColumn Header="Machine" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding MachineChoices}" SelectedItem="{Binding SelectedMachineCandidate, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Reason" Binding="{Binding SelectionReason}" Width="1.2*" IsReadOnly="True" /></DataGrid.Columns></DataGrid></StackPanel></Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="4  Guided review">
                            <Grid Margin="0,8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="{Binding LegacyImport.CurrentImportStageTitle}" FontSize="16" FontWeight="Bold" /><TextBlock Text="{Binding LegacyImport.CurrentImportStageDescription}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                <Border Grid.Row="1" Style="{StaticResource SetupSection}" Margin="0,8"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Pattern scope" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{Binding LegacyImport.PatternScopeChoices}" SelectedValue="{Binding LegacyImport.PatternScope, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" MinWidth="165" Margin="0,0,8,0" ToolTip="Choose which similar rows receive the selected row's explicit choices." /><StackPanel Margin="0,0,8,0"><TextBlock Text="Batch number template (optional)" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding LegacyImport.BatchNumberTemplate, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" ToolTip="Use {part}, {reference}, and {row}. Blank leaves the batch number unresolved." /></StackPanel><TextBlock Text="{Binding LegacyImport.PatternPreviewText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0" /><Button Content="Apply pattern" Command="{Binding LegacyImport.ApplyPatternCommand}" Margin="0,0,8,0" /><Button Content="Apply to similar rows" Command="{Binding LegacyImport.ApplySelectedPatternToSimilarCommand}" Margin="0,0,8,0" /><Button Content="Apply to all matching rows" Command="{Binding LegacyImport.ApplySelectedPatternToAllCommand}" /></WrapPanel></Border>
                                <Grid Grid.Row="2" IsEnabled="{Binding IsEditor}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                    <DataGrid x:Name="WizardImportRowsGrid" Grid.Column="0" ItemsSource="{Binding LegacyImport.CurrentStageRows}" SelectedItem="{Binding LegacyImport.SelectedWizardRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="55" /><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" IsReadOnly="True" /><DataGridTemplateColumn Header="Status" Width="80" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource ImportStatusText}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Source" Binding="{Binding SourceSummary}" Width="2*" IsReadOnly="True" /><DataGridTextColumn Header="Decision" Binding="{Binding DecisionDisplayName}" Width="1.4*" IsReadOnly="True" /></DataGrid.Columns></DataGrid>
                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SetupSection}"><StackPanel DataContext="{Binding LegacyImport.SelectedWizardRow}"><TextBlock Text="Selected row" FontSize="16" FontWeight="Bold" /><TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10" /><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Action" Style="{StaticResource SetupFieldLabel}" /><ComboBox ItemsSource="{Binding ActionChoices}" SelectedValue="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" /></StackPanel><StackPanel Style="{StaticResource ImportExistingOperationSection}"><TextBlock Text="Existing operation" Style="{StaticResource SetupFieldLabel}" /><ComboBox ItemsSource="{Binding AvailableExistingOperationCandidates}" SelectedItem="{Binding SelectedExistingOperationCandidate}" DisplayMemberPath="DisplayName" /></StackPanel><StackPanel Style="{StaticResource ImportCaseSection}"><TextBlock Text="Case candidate" Style="{StaticResource SetupFieldLabel}" /><ComboBox ItemsSource="{Binding CaseCandidates}" SelectedItem="{Binding SelectedCaseCandidate}" DisplayMemberPath="DisplayName" /></StackPanel><StackPanel Style="{StaticResource ImportRouteSection}"><TextBlock Text="Route operation" Style="{StaticResource SetupFieldLabel}" /><ComboBox ItemsSource="{Binding AvailableRouteOperationCandidates}" SelectedItem="{Binding SelectedRouteOperationCandidate}" DisplayMemberPath="DisplayName" /></StackPanel><UniformGrid Columns="2"><StackPanel Style="{StaticResource ImportBatchSection}"><TextBlock Text="Batch number" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Style="{StaticResource ImportOrderSection}"><TextBlock Text="Order number" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding OrderNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid><UniformGrid Columns="2" Style="{StaticResource ImportOrderGrid}"><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Quantity" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding OrderQuantity, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Work Finish Date" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding OrderWorkFinishDate, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid><Expander Header="New Case details (used for open Orders)" Margin="0,4,0,8" Style="{StaticResource ImportNewCaseSection}"><StackPanel><CheckBox Content="Also create this prefilled Order" IsChecked="{Binding IncludeOrderWithNewCase}" ToolTip="Create the prefilled Order together with this new Case." Margin="0,0,0,8" /><UniformGrid Columns="2"><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Part number" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding NewCasePartNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Case name" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding NewCaseName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid><UniformGrid Columns="2"><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Revision" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding NewCaseRevision, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Working folder" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding NewCaseWorkingFolderPath, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid><UniformGrid Columns="2"><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Customer" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding NewCaseCustomer, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Customer reference" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding NewCaseCustomerReference, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid><StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Case notes" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding NewCaseNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /></StackPanel></StackPanel></Expander><StackPanel Style="{StaticResource ImportOrderSection}"><TextBlock Text="Order notes" Style="{StaticResource SetupFieldLabel}" /><TextBox Text="{Binding OrderNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /></StackPanel><StackPanel Style="{StaticResource ImportCompatibilitySection}"><TextBlock Text="{Binding CompatibilityReviewText}" TextWrapping="Wrap" Foreground="#996C00" Margin="0,2,0,5" /><StackPanel Orientation="Horizontal" IsEnabled="{Binding RequiresCompatibilityOverride}" Margin="0,0,0,8"><CheckBox Content="Confirm cross-type assignment" IsChecked="{Binding CompatibilityOverrideConfirmed}" /><TextBox Text="{Binding CompatibilityOverrideReason, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" Margin="8,0,0,0" ToolTip="Mandatory reason" /></StackPanel></StackPanel><StackPanel Style="{StaticResource ImportAllocationsSection}"><DockPanel><TextBlock Text="Allocations" FontWeight="SemiBold" /><Button DockPanel.Dock="Right" Content="Add allocation" Command="{Binding AddAllocationCommand}" /></DockPanel><ItemsControl ItemsSource="{Binding Allocations}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,2"><ComboBox ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding Type}" Width="100" /><ComboBox ItemsSource="{Binding OrderCandidates}" SelectedItem="{Binding SelectedOrderCandidate}" DisplayMemberPath="DisplayName" Width="160" Margin="4,0,0,0" /><TextBox Text="{Binding OrderSourceRowKey}" Width="110" Margin="4,0,0,0" ToolTip="Optional source-row Order reference" /><TextBox Text="{Binding Quantity}" Width="65" Margin="4,0,0,0" /><Button Content="Remove" Command="{Binding DataContext.RemoveAllocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="4,0,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></Border></ScrollViewer>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="5  Review &amp; commit">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource SetupSection}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Review before writing" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="The Server validates the complete selection atomically. Resolve blockers and confirm Machine assignments before committing." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <TextBlock Text="{Binding LegacyImport.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LegacyImport.PreviewSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding LegacyImport.ResultSummary}" Foreground="#20744A" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding LegacyImport.TokenExpiryText}" Foreground="#996C00" Margin="0,3,0,10" />
                                        <DataGrid ItemsSource="{Binding LegacyImport.ReviewRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="55" />
                                                <DataGridTextColumn Header="Source" Binding="{Binding SourceSummary}" Width="2*" />
                                                <DataGridTextColumn Header="Decision" Binding="{Binding DecisionDisplayName}" Width="1.5*" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Issues" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding LegacyImport.Issues}" MaxHeight="220">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#996C00" Margin="0,2" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Import is atomic: the Server either accepts the validated selection or changes nothing." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="6" Visibility="Collapsed" Style="{StaticResource SetupSection}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding LegacyImport.ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" /><TextBlock Text="{Binding LegacyImport.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Back" Command="{Binding LegacyImport.PreviousStepCommand}" IsEnabled="{Binding LegacyImport.CanGoPrevious}" Margin="8,0,0,0" /><Button Grid.Column="2" Content="Next" Command="{Binding LegacyImport.NextStepCommand}" IsEnabled="{Binding LegacyImport.CanGoNext}" Margin="8,0,0,0" /><StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="Skip unresolved" Command="{Binding LegacyImport.SkipAllUnresolvedCommand}" Margin="8,0,0,0" /><Button Content="Import ready items" Command="{Binding LegacyImport.CommitCommand}" IsEnabled="{Binding LegacyImport.CanCommitNow}" Margin="8,0,0,0" /></StackPanel></Grid></Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip="Configure and send production reports">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ReportsButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Reports / Email" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SetupSection}" MaxWidth="760" HorizontalAlignment="Left"><StackPanel IsEnabled="{Binding IsEditor}">
                    <TextBlock Text="Report and email delivery" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Sender address" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ReportSenderAddress}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Recipients (comma-separated)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ReportRecipientsText}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="SMTP host" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ReportSmtpHost}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="SMTP port" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ReportSmtpPort}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Weekly send day" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding Weekdays}" SelectedItem="{Binding WeeklyMaterialReportSendDay}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Weekly send time (HH:mm)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding WeeklyMaterialReportTimeLocal}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Efficiency report send day" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding Weekdays}" SelectedItem="{Binding WeeklyEmployeeEfficiencySendDay}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Efficiency report send time (HH:mm)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding WeeklyEmployeeEfficiencyTimeLocal}"/></StackPanel>
                        <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Time zone" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding ReportTimeZoneId}"/></StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,12"><CheckBox Content="Use SSL" IsChecked="{Binding ReportUseSsl}" Margin="0,0,18,0"/><CheckBox Content="Enable weekly material order report" IsChecked="{Binding WeeklyMaterialReportEnabled}" Margin="0,0,18,0"/><CheckBox Content="Enable weekly employee efficiency report" IsChecked="{Binding WeeklyEmployeeEfficiencyEnabled}"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Button Content="Save report / email settings" Command="{Binding SaveReportEmailSettingsCommand}"/><Button Content="Send weekly material report now" Command="{Binding SendWeeklyMaterialReportNowCommand}" Margin="8,0,0,0"/><Button Content="Send employee efficiency report now" Command="{Binding SendWeeklyEmployeeEfficiencyReportNowCommand}" Margin="8,0,0,0"/></StackPanel>
                    <TextBlock Text="The report contains only Case / Part Number and required material-piece quantity. Quantity uses Batch planned quantity, which already includes scrap allowance." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock Text="Employee efficiency compares recorded planned and actual labor with calendar capacity after breaks, holidays, and employee exceptions. It does not calculate payroll, rank employees, or include machine maintenance." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel></Border></ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="2,8,2,0">
            <Button DockPanel.Dock="Right" Content="Refresh setup data" Command="{Binding RefreshMasterDataCommand}" Margin="8,0,0,0" />
            <StackPanel>
                <TextBlock Text="{Binding AuthorityText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
