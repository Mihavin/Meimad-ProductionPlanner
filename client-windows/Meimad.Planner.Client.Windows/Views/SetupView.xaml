                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Name" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding PostprocessorName}"/></StackPanel>
                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Description" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding PostprocessorDescription}" AcceptsReturn="True" MinHeight="70"/></StackPanel>
