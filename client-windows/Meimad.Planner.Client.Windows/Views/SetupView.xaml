<UserControl x:Class="Meimad.Planner.Client.Windows.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="560">
    <UserControl.Resources>
        <Style x:Key="SetupFieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="SetupField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>
        <Style x:Key="SetupSection" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DDE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="ImportStatusText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#52606D" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Foreground" Value="#20744A" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="#996C00" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Blocked"><Setter Property="Foreground" Value="#B42318" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skip"><Setter Property="Foreground" Value="#667085" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ImportExistingOperationSection" TargetType="StackPanel" BasedOn="{StaticResource SetupField}">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsExistingOperation}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportBatchSection" TargetType="StackPanel" BasedOn="{StaticResource SetupField}">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsBatchInputs}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportRouteSection" TargetType="StackPanel" BasedOn="{StaticResource SetupField}">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsRouteOperation}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportOrderSection" TargetType="StackPanel" BasedOn="{StaticResource SetupField}">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsOrderInputs}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportOrderGrid" TargetType="UniformGrid">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsOrderInputs}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportNewCaseSection" TargetType="Expander">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsNewCaseInputs}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportAllocationsSection" TargetType="StackPanel" BasedOn="{StaticResource SetupField}">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsAllocations}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportCompatibilitySection" TargetType="StackPanel">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsCompatibilityReview}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportCaseSection" TargetType="StackPanel" BasedOn="{StaticResource SetupField}">
            <Style.Triggers><DataTrigger Binding="{Binding ShowsCaseCandidate}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportMachineMappingsSection" TargetType="Border" BasedOn="{StaticResource SetupSection}">
            <Style.Triggers><DataTrigger Binding="{Binding LegacyImport.ShowsMachineMappings}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="WizardStepTabItem" TargetType="TabItem">
            <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><Border Height="0" IsHitTestVisible="False" /></DataTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SetupSection}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Server URL" Style="{StaticResource SetupFieldLabel}" />
                    <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Local user name" Style="{StaticResource SetupFieldLabel}" />
                    <TextBox Text="{Binding LocalUserName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Save" Command="{Binding SaveConnectionCommand}" />
                    <Button Content="Connect" Command="{Binding ConnectCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshConnectionCommand}" Margin="0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,7,0,0"
                            VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding ConnectionHeadline}" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ConnectionDetail}" Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem ToolTip="Manage working calendars, shifts, and breaks">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource CalendarButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Calendars" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SetupSection}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="New" Command="{Binding NewCalendarCommand}" Margin="8,0,0,0" />
                                <TextBlock Text="WORKING CALENDARS" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding WorkingCalendars}"
                                     SelectedItem="{Binding SelectedCalendar}"
                                     DisplayMemberPath="DisplayName"
                                     HorizontalContentAlignment="Stretch" />
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock Text="Dedicated Setup Calendar" Style="{StaticResource SetupFieldLabel}" />
                                <ComboBox ItemsSource="{Binding SetupWorkerCalendars}"
                                          SelectedItem="{Binding SelectedSetupCalendar}"
                                          DisplayMemberPath="Name" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Use for setup" Command="{Binding SetSetupCalendarCommand}" />
                                    <Button Content="Clear" Command="{Binding ClearSetupCalendarCommand}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="Setup personnel may use different availability than Machines."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <TextBlock Text="Israel Master Calendar" Style="{StaticResource SetupFieldLabel}" Margin="0,12,0,0" />
                                <ComboBox ItemsSource="{Binding WorkingCalendars}" SelectedItem="{Binding SelectedMasterCalendar}" DisplayMemberPath="Name" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Use as master" Command="{Binding SetMasterCalendarCommand}" />
                                    <Button Content="Clear" Command="{Binding ClearMasterCalendarCommand}" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SetupSection}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding IsEditor}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CalendarFormHeading}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                            <TextBlock Text="Legacy explicit-window calendars are read-only."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" IsEnabled="{Binding IsCalendarEditable}">
                                <StackPanel Style="{StaticResource SetupField}">
                                    <TextBlock Text="Calendar name" Style="{StaticResource SetupFieldLabel}" />
                                    <TextBox Text="{Binding CalendarName}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SetupField}">
                                    <TextBlock Text="Time zone" Style="{StaticResource SetupFieldLabel}" />
                                    <ComboBox ItemsSource="{Binding CalendarTimeZones}"
                                              Text="{Binding CalendarTimeZoneId, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" IsTextSearchEnabled="True" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Calendar usages" Style="{StaticResource SetupFieldLabel}" />
                            <WrapPanel Margin="0,2,0,12" IsEnabled="{Binding IsCalendarEditable}">
                                <CheckBox Content="Machine" IsChecked="{Binding CalendarUsageMachine}" Margin="0,0,14,0" />
                                <CheckBox Content="Setup worker" IsChecked="{Binding CalendarUsageSetupWorker}" Margin="0,0,14,0" />
                                <CheckBox Content="Regular worker" IsChecked="{Binding CalendarUsageRegularWorker}" Margin="0,0,14,0" />
                                <CheckBox Content="QA worker" IsChecked="{Binding CalendarUsageQaWorker}" />
                            </WrapPanel>
                            <CheckBox Content="Apply cached Israeli holidays to availability"
                                      IsChecked="{Binding CalendarUseIsraeliHolidays}"
                                      IsEnabled="{Binding IsCalendarEditable}" Margin="0,0,0,12"
                                      ToolTip="Uses the local holiday cache. Timeline and resource calculation do not access the internet." />
                            <StackPanel Style="{StaticResource SetupField}" IsEnabled="{Binding IsCalendarEditable}">
                                <TextBlock Text="Working windows (one HH:mm-HH:mm range per line)" Style="{StaticResource SetupFieldLabel}" />
                                <TextBox Text="{Binding CalendarWindowsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="58" VerticalScrollBarVisibility="Auto"
                                         ToolTip="For example: 06:00-10:00 then 10:30-18:00, or one overnight shift such as 17:00-07:00. Windows are shared by the selected workdays." />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SetupField}" IsEnabled="{Binding IsCalendarEditable}">
                                <TextBlock Text="Lunch / break windows (one HH:mm-HH:mm range per line)" Style="{StaticResource SetupFieldLabel}" />
                                <TextBox Text="{Binding CalendarBreakWindowsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="45" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Breaks must be contained within a working window and are removed from availability." />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SetupField}" IsEnabled="{Binding IsCalendarEditable}">
                                <TextBlock Text="Dated exceptions" Style="{StaticResource SetupFieldLabel}" />
                                <TextBox Text="{Binding CalendarExceptionsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="70" VerticalScrollBarVisibility="Auto"
                                         ToolTip="One per line: yyyy-MM-dd | closed | name, or yyyy-MM-dd | 08:00-16:00 | 12:00-12:30 | name. Use commas for multiple windows and - for no breaks." />
                            </StackPanel>
                            <TextBlock Text="Working days" Style="{StaticResource SetupFieldLabel}" />
                            <WrapPanel Margin="0,2,0,12" IsEnabled="{Binding IsCalendarEditable}">
                                <CheckBox Content="Sun" IsChecked="{Binding WorksSunday}" Margin="0,0,14,0" />
                                <CheckBox Content="Mon" IsChecked="{Binding WorksMonday}" Margin="0,0,14,0" />
                                <CheckBox Content="Tue" IsChecked="{Binding WorksTuesday}" Margin="0,0,14,0" />
                                <CheckBox Content="Wed" IsChecked="{Binding WorksWednesday}" Margin="0,0,14,0" />
                                <CheckBox Content="Thu" IsChecked="{Binding WorksThursday}" Margin="0,0,14,0" />
                                <CheckBox Content="Fri" IsChecked="{Binding WorksFriday}" Margin="0,0,14,0" />
                                <CheckBox Content="Sat" IsChecked="{Binding WorksSaturday}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save calendar" Command="{Binding SaveCalendarCommand}" />
                                <Button Content="Delete calendar" Click="DeleteCalendar_Click" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip="Manage production Machines">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource MachinesButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Machines" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SetupSection}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="New" Command="{Binding NewMachineCommand}" Margin="8,0,0,0" />
                                <TextBlock Text="MACHINES" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Machine" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding ProcessType}" Width="120" />
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SetupSection}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding IsEditor}">
                                <TextBlock Text="{Binding MachineFormHeading}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Machine number" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineNumber}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Machine name" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineName}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Reusable Machine Type" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding MachineTypes}" SelectedItem="{Binding SelectedMachineTypeForMachine}" DisplayMemberPath="Name"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Legacy/process type" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineProcessType}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Axis type" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineAxisType}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Working calendar" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding MachineWorkingCalendars}" SelectedItem="{Binding SelectedMachineCalendar}" DisplayMemberPath="Name"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Capabilities (comma-separated)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineCapabilitiesText}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Picture path" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachinePicturePath}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Execution mode" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding MachineExecutionModes}" SelectedItem="{Binding MachineExecutionMode}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Usable tool positions" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineUsableToolPositions}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Rapid rate (mm/min)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineRapidRateMillimetersPerMinute}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Tool-change time (seconds)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineToolChangeTimeSeconds}"/></StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Machine time factor" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding MachineTimeFactor}"/></StackPanel>
                                </UniformGrid>
                                <StackPanel Style="{StaticResource SetupField}">
                                    <TextBlock Text="Supported postprocessors" Style="{StaticResource SetupFieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding MachinePostprocessors}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="0,2,18,4"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="CNC_GCODE readiness accepts only released G-code from one of these explicitly selected postprocessors. MANUAL disables only the G-code requirement."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                    <CheckBox Content="Active" IsChecked="{Binding MachineIsActive}" Margin="0,0,18,0" />
                                    <CheckBox Content="Show on displays" IsChecked="{Binding MachineDisplayEnabled}" />
                                    <CheckBox Content="Respect Israel Master Calendar" IsChecked="{Binding MachineRespectMasterCalendar}" Margin="18,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save machine" Command="{Binding SaveMachineCommand}" />
                                    <Button Content="Deactivate" Command="{Binding DeactivateMachineCommand}" />
                                    <Button Content="Delete" Click="DeleteMachine_Click" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="The Server blocks unsafe deactivation/deletion when planning assignments or other references exist."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Expander Header="CNC Connection" IsExpanded="False" Margin="0,16,0,0">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Adapter Type" Style="{StaticResource SetupFieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding CncAdapters}" SelectedItem="{Binding SelectedCncAdapter}"
                                                  DisplayMemberPath="ChoiceLabel" Margin="0,2,0,3"/>
                                        <TextBlock Text="{Binding CncAdapterAvailability}" Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <TextBlock Text="Haas NGC configuration" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Machine-side identity comes from a direct DPRNT PartName or the active NC program header. File name and O-number remain separate and never identify the Part."
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="IP / Hostname" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasHost}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="MDC Port" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasMdcPort}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="MTConnect Port" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasMtConnectPort}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="DPRNT PartName Port" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasDprntPort}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Machine telemetry source" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding HaasTelemetryProviders}" SelectedItem="{Binding HaasTelemetryProvider}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Part counter source" Style="{StaticResource SetupFieldLabel}"/><ComboBox ItemsSource="{Binding HaasPartCounterSources}" SelectedItem="{Binding HaasPartCounterSource}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Polling interval (ms)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasPollingIntervalMs}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Connection timeout (ms)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasConnectionTimeoutMs}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Local Net Share path" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasLocalNetSharePath}"/></StackPanel>
                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Credential reference (no password)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding HaasCredentialsReference}"/></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="MTConnect and DPRNT are read-only. Set the DPRNT output port configured on the Haas. Workflow state is owned by immutable Server events, not a persistent CNC variable."
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <CheckBox Content="Local Net Share enabled" IsChecked="{Binding HaasLocalNetShareEnabled}" Margin="0,0,18,0"/>
                                            <CheckBox Content="Enable Server polling" IsChecked="{Binding HaasEnabled}"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <Button Content="Load configuration" Command="{Binding LoadHaasConfigurationCommand}"/>
                                            <Button Content="Save Haas configuration" Command="{Binding SaveHaasConfigurationCommand}"/>
                                            <Button Content="Test Connection" Command="{Binding TestHaasConnectionCommand}"/>
                                            <Button Content="Test MTConnect" Command="{Binding TestHaasMtConnectCommand}"/>
                                            <Button Content="Test MDC" Command="{Binding TestHaasMdcCommand}"/>
                                            <Button Content="Test Net Share" Command="{Binding TestHaasNetShareCommand}"/>
                                            <Button Content="Refresh monitoring" Command="{Binding RefreshHaasMonitorCommand}" Margin="0"/>
                                            <Button Content="Reconnect" Command="{Binding ReconnectCncCommand}" Margin="8,0,0,0"/>
                                        </WrapPanel>
                                        <Border BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="3" Padding="9" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding HaasDiagnostics}" TextWrapping="Wrap"/>
                                        </Border>
                                        <Expander Header="Protected setup verification (commissioning gated)" Margin="0,10,0,0">
                                            <StackPanel Margin="8">
                                                <TextBlock Text="These values configure the Server-side contract only. Keep verification disabled until the protected Haas macros and physical Machine behavior are commissioned and proven."
                                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="DPRINT transport port" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationDprintPort}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Challenge program (O9xxx)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationChallengeProgram}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Verify program (O9xxx)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationVerifyProgram}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Custom G-code alias (optional)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationCustomGcodeAlias}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Nonce variable" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationNonceVariable}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Response variable" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationResponseVariable}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Verification-state variable" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationStateVariable}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Release-token variable" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationReleaseTokenVariable}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Machine secret (blank preserves)" Style="{StaticResource SetupFieldLabel}"/><PasswordBox PasswordChanged="VerificationSecret_PasswordChanged"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Expected macro version" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationMacroVersion}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Response digits (4–6)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationCodeDigits}"/></StackPanel>
                                                    <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Verification timeout (seconds)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationTimeoutSeconds}"/></StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="{Binding VerificationSecretStatus}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                                <CheckBox Content="Enable protected verification after commissioning" IsChecked="{Binding VerificationEnabled}" Margin="0,0,0,8"/>
                                                <WrapPanel>
                                                    <Button Content="Load verification configuration" Command="{Binding LoadVerificationConfigurationCommand}"/>
                                                    <Button Content="Save verification configuration" Command="{Binding SaveVerificationConfigurationCommand}" Margin="0"/>
                                                </WrapPanel>
                                                <Border BorderBrush="#C62828" BorderThickness="1" Padding="9" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Audited recovery — no verification bypass" FontWeight="Bold"/>
                                                        <TextBlock Text="Use only to restore a valid process. Invalidate/revoke require a reason; immutable releases and workflow evidence are preserved."
                                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                                        <UniformGrid Columns="2">
                                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Production Run ID" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationRecoveryRunId}"/></StackPanel>
                                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Recovery reason (required)" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationRecoveryReason}"/></StackPanel>
                                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Approved NC release ID" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationRecoveryNcReleaseId}"/></StackPanel>
                                                            <StackPanel Style="{StaticResource SetupField}"><TextBlock Text="Tool-table release ID" Style="{StaticResource SetupFieldLabel}"/><TextBox Text="{Binding VerificationRecoveryToolTableReleaseId}"/></StackPanel>
                                                        </UniformGrid>
                                                        <WrapPanel>
                                                            <Button Content="Generate replacement Offset Loader" Command="{Binding GenerateOffsetLoaderReleaseCommand}"/>
                                                            <Button Content="Invalidate current verification" Command="{Binding InvalidateVerificationCommand}"/>
                                                            <Button Content="Revoke current Offset Loader" Command="{Binding RevokeCurrentOffsetLoaderCommand}" Margin="0"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="BENCH TIMELINE" FontWeight="Bold" Margin="0,10,0,4"/>
                                        <Border BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="3" Padding="9">
                                            <TextBlock Text="{Binding HaasTimeline}" TextWrapping="Wrap" FontFamily="Consolas"/>
                                        </Border>
                                        <TextBlock Text="Direct macro writes are disabled. Protected temporary verification variables will be configured separately after controller commissioning."
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Machine Availability">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SetupSection}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Add maintenance" Command="{Binding NewPlannedMaintenanceCommand}" Margin="0,0,6,0" />
                                    <Button Content="Mark broken" Command="{Binding ReportBreakdownCommand}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="MACHINE DOWNTIME" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Downtimes}" SelectedItem="{Binding SelectedDowntime}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Window" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SetupSection}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding IsEditor}">
                                <TextBlock Text="{Binding DowntimeFormHeading}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <StackPanel Style="{StaticResource SetupField}">
                                        <TextBlock Text="Machine" Style="{StaticResource SetupFieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedDowntimeMachine}" DisplayMemberPath="DisplayName" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}">
                                        <TextBlock Text="Type" Style="{StaticResource SetupFieldLabel}" />
                                        <TextBox Text="{Binding DowntimeType, Mode=OneWay}" IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}">
                                        <TextBlock Text="Start (yyyy-MM-dd HH:mm)" Style="{StaticResource SetupFieldLabel}" />
                                        <TextBox Text="{Binding DowntimeStartsAt}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}">
                                        <TextBlock Text="Maintenance end" Style="{StaticResource SetupFieldLabel}" />
                                        <TextBox Text="{Binding DowntimeEndsAt}" IsEnabled="{Binding IsPlannedMaintenance}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}">
                                        <TextBlock Text="Planned / reported by" Style="{StaticResource SetupFieldLabel}" />
                                        <TextBox Text="{Binding DowntimeActor}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SetupField}">
                                        <TextBlock Text="Restore time" Style="{StaticResource SetupFieldLabel}" />
                                        <TextBox Text="{Binding DowntimeRestoredAt}" IsEnabled="{Binding IsBreakdown}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Style="{StaticResource SetupField}">
                                    <TextBlock Text="Reason / note" Style="{StaticResource SetupFieldLabel}" />
                                    <TextBox Text="{Binding DowntimeReason}" AcceptsReturn="True" MinHeight="52" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SetupField}">
                                    <TextBlock Text="Repair note" Style="{StaticResource SetupFieldLabel}" />
                                    <TextBox Text="{Binding DowntimeRepairNote}" AcceptsReturn="True" MinHeight="52" IsEnabled="{Binding IsBreakdown}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save maintenance / report breakdown" Command="{Binding SaveDowntimeCommand}" />
                                    <Button Content="Mark restored" Command="{Binding RestoreBreakdownCommand}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="Active breakdowns remain unavailable until Mark restored. Timeline recalculation never changes backlog order."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip="Manage Machine Types and capabilities">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource MachinesButtonIcon}" Width="20" Height="20" Margin="0,0,5,0" /><TextBlock Text="Machine Types" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
