<UserControl x:Class="Meimad.Planner.Client.Windows.Views.MachinePlanningBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="690">
    <UserControl.Resources>
        <DataTemplate x:Key="OperationCardTemplate">
            <Border Background="White" BorderBrush="#D5DAE0" BorderThickness="1"
                    CornerRadius="3" Padding="10" Margin="3,3,3,7">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding OperationName}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RequiredMachineText, StringFormat=Requires: {0}}"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Start" Click="StartOperation_Click"
                                IsEnabled="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanStart}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Suspend" Click="SuspendOperation_Click"
                                IsEnabled="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanSuspend}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Finish" Click="FinishOperation_Click" Margin="0"
                                IsEnabled="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanFinish}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="#D8DDE3"
            BorderThickness="1" CornerRadius="5" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Add Calendar" Command="{Binding BeginAddCalendarCommand}" />
                    <Button Content="Add Machine" Command="{Binding BeginAddMachineCommand}" />
                    <Button Content="Refresh Board" Command="{Binding RefreshCommand}" Margin="0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MACHINE PLANNING BOARD" FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Manual assignment and backlog order" FontSize="22"
                               FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ModeInstruction}" Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="#EEF4F8" BorderBrush="#B9C8D4"
                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAddingMachine}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Cancel" Command="{Binding CancelAddMachineCommand}" />
                            <Button Content="{Binding MachineSaveButtonText}" Command="{Binding SaveMachineCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding MachineFormHeading}" FontWeight="Bold" />
                            <TextBlock Text="All values are sent to the Server; the picture remains an external path."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,12,9"><TextBlock Text="Number *" FontWeight="SemiBold"/><TextBox Text="{Binding MachineNumber}"/></StackPanel>
                        <StackPanel Margin="0,0,12,9"><TextBlock Text="Name *" FontWeight="SemiBold"/><TextBox Text="{Binding MachineName}"/></StackPanel>
                        <StackPanel Margin="0,0,12,9"><TextBlock Text="Process type *" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding MachineProcessTypes}" SelectedItem="{Binding MachineProcessType}"/></StackPanel>
                        <StackPanel Margin="0,0,0,9"><TextBlock Text="Axis type" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding MachineAxisTypes}" SelectedItem="{Binding MachineAxisType}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Capabilities (comma-separated)" FontWeight="SemiBold"/><TextBox Text="{Binding MachineCapabilitiesText}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Working Calendar *" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding WorkingCalendars}" SelectedItem="{Binding SelectedWorkingCalendar}" DisplayMemberPath="DisplayName"/></StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Picture path" FontWeight="SemiBold"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseMachinePicture_Click" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding MachinePicturePath}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <CheckBox Content="Active" IsChecked="{Binding MachineIsActive}" Margin="0,0,16,0"/>
                            <CheckBox Content="Show on displays" IsChecked="{Binding MachineDisplayEnabled}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#EEF4F8" BorderBrush="#B9C8D4"
                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAddingCalendar}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Cancel" Command="{Binding CancelAddCalendarCommand}" />
                            <Button Content="Create Calendar" Command="{Binding SaveCalendarCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="NEW WORKING CALENDAR" FontWeight="Bold" />
                            <TextBlock Text="Choose a timezone, workweek, and one continuous daily shift."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Name *" FontWeight="SemiBold"/><TextBox Text="{Binding CalendarName}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Time zone *" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding CalendarTimeZones}" SelectedItem="{Binding CalendarTimeZoneId}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Workweek *" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding CalendarWorkweeks}" SelectedItem="{Binding SelectedCalendarWorkweek}" DisplayMemberPath="Label"/></StackPanel>
                        <StackPanel><TextBlock Text="Shift *" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding CalendarShifts}" SelectedItem="{Binding SelectedCalendarShift}" DisplayMemberPath="Label"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F2F5F8" BorderBrush="#CCD3DA"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,2,4,9">
                            <TextBlock Text="UNASSIGNED OPERATION POOL" FontWeight="Bold" />
                            <TextBlock Text="Drag an operation to a Machine column. Drop here to unassign."
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ListBox x:Name="OperationPool"
                                 Grid.Row="1"
                                 ItemsSource="{Binding Pool}"
                                 ItemTemplate="{StaticResource OperationCardTemplate}"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="DragSource_PreviewMouseMove"
                                 DragOver="Pool_DragOver"
                                 Drop="Pool_Drop"
                                 HorizontalContentAlignment="Stretch"
                                 BorderThickness="0"
                                 Background="Transparent" />
                        <TextBlock Grid.Row="2" Text="{Binding Pool.Count, StringFormat={}{0} unassigned operations}"
                                   FontWeight="SemiBold" Margin="4,8,4,2" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#F2F5F8" BorderBrush="#CCD3DA"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,2,4,9">
                            <TextBlock Text="MACHINE BACKLOGS" FontWeight="Bold" />
                            <TextBlock Text="Drop on a card to choose its position, or below the cards to append."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Machines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="310" Margin="3,0,10,0" Background="White"
                                                BorderBrush="#CCD3DA" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="#E8EEF4" Padding="11">
                                                    <StackPanel>
                                                        <Border Height="90" Background="#F7F9FA" BorderBrush="#CCD3DA"
                                                                BorderThickness="1" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Image Source="{Binding Picture}" Stretch="Uniform" />
                                                                <TextBlock Text="{Binding PictureStatus}" FontSize="10"
                                                                           Background="#DFFFFFFF" Padding="3"
                                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="17" />
                                                        <TextBlock Text="{Binding CompatibilityText, StringFormat=Accepts: {0}}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding MachineStatusText}" FontWeight="SemiBold"
                                                                   Margin="0,4,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="Edit Machine" Click="EditMachine_Click"
                                                                    IsEnabled="{Binding DataContext.CanAddMachine, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            <Button Content="Delete" Click="DeleteMachine_Click" Margin="0"
                                                                    IsEnabled="{Binding DataContext.CanAddMachine, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <ListBox Grid.Row="1"
                                                         ItemsSource="{Binding Backlog}"
                                                         ItemTemplate="{StaticResource OperationCardTemplate}"
                                                         AllowDrop="True"
                                                         PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                                         PreviewMouseMove="DragSource_PreviewMouseMove"
                                                         DragOver="MachineBacklog_DragOver"
                                                         Drop="MachineBacklog_Drop"
                                                         HorizontalContentAlignment="Stretch"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         MinHeight="250" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Backlog.Count, StringFormat={}{0} queued operations}"
                                                           FontWeight="SemiBold" Margin="11,8" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="#FFF8E1" BorderBrush="{StaticResource YellowBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CONFLICTS" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="{Binding ConflictCalculationStatus}" TextWrapping="Wrap"
                                   Margin="0,5,0,8" Foreground="{StaticResource MutedTextBrush}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ServerConflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource RedBrush}" BorderThickness="3,0,0,0"
                                                Background="White" Padding="9" Margin="0,0,0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SignalText}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ASSIGNMENT FEEDBACK" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Server rejections are shown here; rejected drops never change the board."
                                   TextWrapping="Wrap" Margin="0,5,0,8"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Feedback}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" Padding="9" Margin="0,0,0,7"
                                                BorderBrush="#D8DDE3" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SignalText}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
