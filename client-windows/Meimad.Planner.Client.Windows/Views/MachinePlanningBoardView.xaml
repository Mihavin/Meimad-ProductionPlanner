<UserControl x:Class="Meimad.Planner.Client.Windows.Views.MachinePlanningBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="540">
    <UserControl.Resources>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Fill" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EEF4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D6E0E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OperationCardTemplate">
            <Border Background="White" BorderBrush="#D5DAE0" BorderThickness="1"
                    CornerRadius="3" Padding="7" Margin="2,2,2,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusGlyph}"
                                   FontWeight="Bold" FontSize="15" Margin="7,0,0,0"
                                   ToolTip="{Binding StatusDetail}" />
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="{Binding OperationName}" Margin="0,2,0,0"
                               FontSize="12" TextTrimming="CharacterEllipsis" />

                    <WrapPanel Grid.Row="2" Margin="0,3,0,0">
                        <TextBlock Text="{Binding PlannedQuantityText}" FontWeight="SemiBold" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding EstimatedTimeText}" FontWeight="SemiBold" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}"
                                   ToolTip="{Binding StatusDetail}" />
                    </WrapPanel>

                    <DockPanel Grid.Row="3" Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="▶" ToolTip="Start operation" AutomationProperties.Name="Start operation"
                                    Click="StartOperation_Click" Tag="M 1,0 L 11,6 L 1,12 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanStart}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="True" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Ⅱ" ToolTip="Pause operation" AutomationProperties.Name="Pause operation"
                                    Click="SuspendOperation_Click" Tag="M 0,0 H 4 V 12 H 0 Z M 8,0 H 12 V 12 H 8 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanSuspend}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="True" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="■" ToolTip="Finish operation" AutomationProperties.Name="Finish operation"
                                    Click="FinishOperation_Click" Margin="0" Tag="M 1,1 H 11 V 11 H 1 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Setter Property="Margin" Value="0,0,5,0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanFinish}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="True" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Reset" ToolTip="Reset paused operation to Not started" AutomationProperties.Name="Reset operation"
                                    Click="ResetOperation_Click" Margin="0"
                                    Tag="M 10,2 V 0 L 12,3 L 10,6 V 4 C 6,1 2,3 2,6 C 2,9 5,11 8,10 L 9,12 C 4,14 0,11 0,6 C 0,1 6,-2 10,2 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanReset}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="True" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding OrderReferencesText}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding OrderReferencesText}" />
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompactOperationRowTemplate">
            <Border Background="White" BorderBrush="#D5DAE0" BorderThickness="1"
                    CornerRadius="3" Padding="4" Margin="1,1,1,3">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Schedule from delivery date"
                                  ToolTip="Set Backward mode on this existing assignment. The Timeline will calculate the same block near its Work Finish Date."
                                  IsEnabled="{Binding CanScheduleBackward}"
                                  Click="ScheduleBackward_Click"
                                  AutomationProperties.Name="Schedule from delivery date" />
                        <MenuItem Header="Schedule forward"
                                  ToolTip="Set Forward mode on this existing assignment."
                                  IsEnabled="{Binding CanScheduleForward}"
                                  Click="ScheduleForward_Click"
                                  AutomationProperties.Name="Schedule forward" />
                        <MenuItem Header="Set manual mode"
                                  ToolTip="Use the stored manual Machine backlog order for this existing assignment."
                                  IsEnabled="{Binding CanSetManualMode}"
                                  Click="SetManualMode_Click"
                                  AutomationProperties.Name="Set manual mode" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="#EEF1F4" BorderBrush="#D4D9DE"
                            BorderThickness="1" VerticalAlignment="Center">
                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                    </Border>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="4,0,1,0"
                                     ToolTip="{Binding StatusDetail}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#8A949E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="not_started"><Setter Property="Fill" Value="#8A949E" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="in_progress"><Setter Property="Fill" Value="#18864B" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="suspended"><Setter Property="Fill" Value="#D79B00" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="completed"><Setter Property="Fill" Value="#2878B5" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PartCaseText}" FontSize="11" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PartCaseText}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding OperationText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OperationText}" />
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PlanningModeText}" FontSize="10"
                                       FontWeight="SemiBold" Margin="6,0,0,0"
                                       ToolTip="Planning mode for this Machine assignment" />
                            <TextBlock Text="{Binding BatchOrderText}" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BatchOrderText}" />
                        </DockPanel>
                    </Grid>

                    <StackPanel Grid.Column="3" Margin="5,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                            <TextBlock Text="{Binding PlannedQuantityText}" FontSize="10" FontWeight="SemiBold" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding EstimatedTimeText}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Start" ToolTip="Start operation" AutomationProperties.Name="Start operation"
                                    Click="StartOperation_Click" Tag="M 1,0 L 11,6 L 1,12 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Setter Property="Width" Value="24"/><Setter Property="MinHeight" Value="21"/><Setter Property="Margin" Value="0,0,3,0"/>
                                        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanStart}" Value="True" />
                                            <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True" /></MultiDataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Pause" ToolTip="Pause operation" AutomationProperties.Name="Pause operation"
                                    Click="SuspendOperation_Click" Tag="M 0,0 H 4 V 12 H 0 Z M 8,0 H 12 V 12 H 8 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Setter Property="Width" Value="24"/><Setter Property="MinHeight" Value="21"/><Setter Property="Margin" Value="0,0,3,0"/>
                                        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanSuspend}" Value="True" />
                                            <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True" /></MultiDataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Finish" ToolTip="Finish operation" AutomationProperties.Name="Finish operation"
                                    Click="FinishOperation_Click" Tag="M 1,1 H 11 V 11 H 1 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Setter Property="Width" Value="24"/><Setter Property="MinHeight" Value="21"/><Setter Property="Margin" Value="0,0,3,0"/>
                                        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanFinish}" Value="True" />
                                            <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True" /></MultiDataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Reset" ToolTip="Reset paused operation to Not started" AutomationProperties.Name="Reset operation"
                                    Click="ResetOperation_Click"
                                    Tag="M 10,2 V 0 L 12,3 L 10,6 V 4 C 6,1 2,3 2,6 C 2,9 5,11 8,10 L 9,12 C 4,14 0,11 0,6 C 0,1 6,-2 10,2 Z">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayerButton}">
                                        <Setter Property="Width" Value="24"/><Setter Property="MinHeight" Value="21"/><Setter Property="Margin" Value="0"/>
                                        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanReset}" Value="True" />
                                            <Condition Binding="{Binding DataContext.CanDrag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True" /></MultiDataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="#D8DDE3"
            BorderThickness="1" CornerRadius="5" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="148" />
            </Grid.RowDefinitions>

            <DockPanel Margin="2,0,2,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                <StackPanel>
                    <TextBlock Text="MACHINE PLANNING BOARD" FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ModeInstruction}" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,2,0,0"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F2F5F8" BorderBrush="#CCD3DA"
                        BorderThickness="1" CornerRadius="4" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,5">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Pool.Count, StringFormat={}{0}}"
                                       FontWeight="Bold" />
                            <TextBlock Text="UNASSIGNED" FontWeight="Bold" />
                        </DockPanel>
                        <ListBox x:Name="OperationPool" Grid.Row="1"
                                 ItemsSource="{Binding Pool}"
                                 ItemTemplate="{StaticResource CompactOperationRowTemplate}"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="DragSource_PreviewMouseMove"
                                 DragOver="Pool_DragOver"
                                 Drop="Pool_Drop"
                                 HorizontalContentAlignment="Stretch"
                                 BorderThickness="0" Background="Transparent" />
                        <TextBlock Grid.Row="2" Text="Drop here to unassign"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="2,5,2,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#F2F5F8" BorderBrush="#CCD3DA"
                        BorderThickness="1" CornerRadius="4" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="MACHINE BACKLOGS — drag cards to assign or reorder"
                                   FontWeight="Bold" Margin="2,0,2,5" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Machines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="286" Margin="2,0,8,0" Background="White"
                                                BorderBrush="#CCD3DA" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="#E8EEF4" Padding="7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="44" Height="40" Background="#F7F9FA"
                                                                BorderBrush="#CCD3DA" BorderThickness="1">
                                                            <Image Source="{Binding Picture}" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CompatibilityText, StringFormat=Accepts: {0}}"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding CompatibilityText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ListBox Grid.Row="1" ItemsSource="{Binding Backlog}"
                                                         ItemTemplate="{StaticResource CompactOperationRowTemplate}"
                                                         AllowDrop="True"
                                                         PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                                         PreviewMouseMove="DragSource_PreviewMouseMove"
                                                         DragOver="MachineBacklog_DragOver"
                                                         Drop="MachineBacklog_Drop"
                                                         HorizontalContentAlignment="Stretch"
                                                         BorderThickness="0" Background="Transparent" MinHeight="150" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Backlog.Count, StringFormat={}{0} queued}"
                                                           FontWeight="SemiBold" Margin="8,5" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#FFF8E1" BorderBrush="{StaticResource YellowBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CONFLICTS" FontWeight="Bold" />
                        <TextBlock Text="{Binding ConflictCalculationStatus}" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,4" Foreground="{StaticResource MutedTextBrush}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ServerConflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource RedBrush}" BorderThickness="3,0,0,0"
                                                Background="White" Padding="6" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SERVER FEEDBACK" FontWeight="Bold" />
                        <TextBlock Text="Rejected moves never change the board."
                                   Margin="0,2,0,4" Foreground="{StaticResource MutedTextBrush}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Feedback}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" Padding="6" Margin="0,0,0,4"
                                                BorderBrush="#D8DDE3" BorderThickness="1">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
