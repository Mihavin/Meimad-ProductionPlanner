<UserControl x:Class="Meimad.Planner.Client.Windows.Views.PreparationQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="5*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="2*" MinWidth="340" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,8" />
      <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False" IsReadOnly="True" MinHeight="300"
                HorizontalScrollBarVisibility="Auto" FrozenColumnCount="1" Tag="{Binding}">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open Case"
                      Command="{Binding PlacementTarget.Tag.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Open Operation"
                      Command="{Binding PlacementTarget.Tag.OpenOperationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Upload G-code"
                      Command="{Binding PlacementTarget.Tag.UploadGCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
              <MenuItem.Style>
                <Style TargetType="MenuItem">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PlacementTarget.Tag.Stage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                 Value="PROGRAMMING_PENDING">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Open Tool Table"
                      Command="{Binding PlacementTarget.Tag.OpenToolTableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
              <MenuItem.Style>
                <Style TargetType="MenuItem">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding PlacementTarget.Tag.Stage, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="TOOL_PREPARATION_PENDING"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="View NC File (read-only)"
                      Command="{Binding PlacementTarget.Tag.ViewNcFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
              <MenuItem.Style>
                <Style TargetType="MenuItem"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PlacementTarget.Tag.Stage, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="TOOL_PREPARATION_PENDING"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
              </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Create Production Package"
                      Command="{Binding PlacementTarget.Tag.CreateProductionPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
              <MenuItem.Style>
                <Style TargetType="MenuItem"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PlacementTarget.Tag.Stage, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="TOOL_PREPARATION_PENDING"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
              </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Create Production Package — Manual / Dummy Tool Offsets"
                      Command="{Binding PlacementTarget.Tag.CreateManualOffsetProductionPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
              <MenuItem.Style>
                <Style TargetType="MenuItem"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PlacementTarget.Tag.Stage, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="TOOL_PREPARATION_PENDING"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
              </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Open Production Package"
                      Command="{Binding PlacementTarget.Tag.OpenProductionPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
              <MenuItem.Style>
                <Style TargetType="MenuItem"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PlacementTarget.Tag.Stage, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="SETUP_PENDING"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
              </MenuItem.Style>
            </MenuItem>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Machine" Binding="{Binding MachineText}" Width="180" />
          <DataGridTextColumn Header="Part" Binding="{Binding PartText}" Width="180" />
          <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="110" />
          <DataGridTextColumn Header="Operation" Binding="{Binding OperationText}" Width="190" />
          <DataGridTextColumn Header="Workflow" Binding="{Binding WorkflowText}" Width="145" />
          <DataGridTextColumn Header="Production Run" Binding="{Binding ProductionRunText}" Width="170" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Border Grid.Column="2" Background="White" BorderBrush="#D8DDE3"
            BorderThickness="1" Padding="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Preparation facts" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Queue membership is calculated from Server facts; this view cannot change the Machine."
                     TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                     Margin="0,6,0,12" />
          <TextBlock Text="Machine" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Selected.MachineText, TargetNullValue=Select a queue item}" />
          <TextBlock Text="Part / operation" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Selected.PartText, TargetNullValue=—}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Selected.OperationText, TargetNullValue=—}" TextWrapping="Wrap" />
          <TextBlock Text="Current G-code release" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Selected.GCodeReleaseText, TargetNullValue=—}" TextWrapping="Wrap" />
          <TextBlock Text="Current Tool Table release" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Selected.ToolTableReleaseText, TargetNullValue=—}" TextWrapping="Wrap" />
          <TextBlock Text="Workflow" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Selected.WorkflowText, TargetNullValue=—}" />
          <Separator Margin="0,14" />
          <TextBlock Text="Gate details" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Selected.ReadinessFacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#D8DDE3" BorderThickness="0,0,0,1" Padding="0,7">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
