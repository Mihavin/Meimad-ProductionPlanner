<UserControl x:Class="Meimad.Planner.Client.Windows.Views.ShopOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Meimad.Planner.Client.Windows.Views">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel><WrapPanel><Button Content="Refresh" Command="{Binding RefreshCommand}" /><Button Content="Inspect selected output" Command="{Binding OpenCommand}" /></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,5" /></StackPanel>
  <DataGrid x:Name="MachineList" Grid.Row="1" ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" CanUserAddRows="False" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Machine" Binding="{Binding Number}" Width="80" /><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
    <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="140" /><DataGridTextColumn Header="Freshness" Binding="{Binding Freshness}" Width="110" />
    <DataGridTextColumn Header="Observed state" Binding="{Binding Observation}" Width="140" /><DataGridTextColumn Header="Observed (UTC)" Binding="{Binding ObservedAt, StringFormat=u}" Width="180" />
    <DataGridTextColumn Header="Runs in backlog" Binding="{Binding BacklogRuns}" Width="100" /><DataGridTextColumn Header="Next committed Run" Binding="{Binding NextCommittedRun}" Width="250" />
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="OutputHeading" Grid.Row="2" Text="Recorded Run outputs — select the exact program and output" Margin="0,12,0,5" FontWeight="SemiBold" />
  <DataGrid x:Name="OutputList" Grid.Row="3" ItemsSource="{Binding SelectedMachine.Outputs}" SelectedItem="{Binding SelectedOutput}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" CanUserAddRows="False" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Run" Binding="{Binding RunId}" Width="210" /><DataGridTextColumn Header="Program" Binding="{Binding ProgramId}" Width="210" />
    <DataGridTextColumn Header="Part" Binding="{Binding Output.PartNumber}" Width="110" /><DataGridTextColumn Header="Operation" Binding="{Binding Output.OperationNumber}" Width="80" />
    <DataGridTextColumn Header="Target" Binding="{Binding Output.TargetQuantity}" Width="75" /><DataGridTextColumn Header="Produced" Binding="{Binding Output.ProducedQuantity}" Width="75" />
    <DataGridTextColumn Header="Remaining" Binding="{Binding Output.RemainingQuantity}" Width="85" /><DataGridTextColumn Header="State" Binding="{Binding RunState}" Width="120" />
    <DataGridTextColumn Header="Readiness" Binding="{Binding Readiness}" Width="190" />
   </DataGrid.Columns>
  </DataGrid>
  <Expander x:Name="ShopShiftEvidence" Grid.Row="4" Header="Shift summary / Server evidence" Margin="0,8,0,0" VerticalAlignment="Stretch">
   <views:LocalAiPanel x:Name="ShiftEvidencePanel" DataContext="{Binding Ai}" />
  </Expander>
 </Grid>
</UserControl>
