<UserControl x:Class="Meimad.Planner.Client.Windows.Views.UserTerminalsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource CanvasBrush}">
  <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0"><DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"/><TextBlock Text="User Terminals" FontSize="20" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><DataGrid ItemsSource="{Binding Terminals}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="300"><DataGrid.Columns><DataGridTextColumn Header="Tablet" Binding="{Binding TabletId}"/><DataGridTextColumn Header="Name" Binding="{Binding DeviceName}"/><DataGridTextColumn Header="Machine" Binding="{Binding BindingText}"/><DataGridTextColumn Header="State" Binding="{Binding StateText}"/></DataGrid.Columns></DataGrid></StackPanel>
    <Border Grid.Column="2" Background="White" BorderBrush="#D8DDE3" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="Tablet configuration" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Read-only in View Mode. Tablet communication is confirmed after an authenticated bootstrap reaches the Server." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,12"/><TextBlock Text="Device name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Wi-Fi MAC address" Margin="0,8,0,0"/><TextBox Text="{Binding HardwareId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Machine binding" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}" DisplayMemberPath="Name"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="New" Command="{Binding NewCommand}"/><Button Content="Save / Assign" Command="{Binding SaveCommand}"/><Button Content="Enable / Disable" Command="{Binding ToggleEnabledCommand}"/></StackPanel><Button Content="Rotate credential" Command="{Binding RotateCredentialCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/><TextBlock Text="Provisioning credential - copy now; it cannot be retrieved later" FontWeight="SemiBold" Margin="0,16,0,3"/><TextBox Text="{Binding ProvisioningToken, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="45"/></StackPanel></Border>
  </Grid>
</UserControl>
