<Application x:Class="Meimad.Planner.Client.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111111" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6670" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F7" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1E88E5" />
        <SolidColorBrush x:Key="GreenBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="YellowBrush" Color="#FBC02D" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#F57C00" />
        <SolidColorBrush x:Key="RedBrush" Color="#C62828" />
        <SolidColorBrush x:Key="GreyBrush" Color="#9E9E9E" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
