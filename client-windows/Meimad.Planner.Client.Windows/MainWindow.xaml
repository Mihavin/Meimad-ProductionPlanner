<Window x:Class="Meimad.Planner.Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meimad.Planner.Client.Windows.Views"
        Title="Meimad Production Planner"
        Width="1380"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#18324A" Padding="28,20">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding LocalIdentityText}"
                           Foreground="White"
                           Opacity="0.88"
                           VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="MEIMAD PRODUCTION PLANNER"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Factory-local Windows planning client"
                               Foreground="White"
                               Opacity="0.72"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#D8DDE3"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Server connection"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Settings are stored locally. This client connects only through HTTP API routes."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Server URL" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Local user name" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding LocalUserName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Connect / Save" Command="{Binding ConnectCommand}" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="#D8DDE3"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="SERVER STATUS" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding HealthHeadline}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource GreyBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthLevel}" Value="healthy">
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthLevel}" Value="attention">
                                                <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthLevel}" Value="offline">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding HealthDetail}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="#D8DDE3"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="EDIT AUTHORITY" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding ModeHeadline}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource GreyBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModeLevel}" Value="editor">
                                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModeLevel}" Value="requesting">
                                                <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModeLevel}" Value="viewer">
                                                <Setter Property="Foreground" Value="{StaticResource GreyBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModeLevel}" Value="offline">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ModeDetail}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Request Edit Mode" Command="{Binding RequestEditCommand}" />
                                <Button Content="Release Edit Mode" Command="{Binding ReleaseEditCommand}" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#FFF8E1"
                        BorderBrush="{StaticResource YellowBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="18"
                        Margin="0,18,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingTransfer}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Release / Transfer" Command="{Binding ApproveTransferCommand}" />
                            <Button Content="Reject" Command="{Binding RejectTransferCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="⚠ Edit Mode transfer request" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{Binding PendingTransferText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl Margin="0,18,0,0">
                    <TabItem Header="Cases">
                        <views:CaseWorkspaceView DataContext="{Binding CaseWorkspace}" Margin="8" />
                    </TabItem>
                    <TabItem Header="Machine Planning Board">
                        <views:MachinePlanningBoardView DataContext="{Binding MachinePlanningBoard}" Margin="8" />
                    </TabItem>
                    <TabItem Header="Timeline">
                        <views:TimelineView DataContext="{Binding Timeline}" Margin="8" />
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#E7EBEF" Padding="28,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="No direct database access"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource GreenBrush}" />
                <TextBlock Text="Status refreshes every 5 seconds while the Server is available."
                           Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
