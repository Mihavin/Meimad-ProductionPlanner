<Window x:Class="Meimad.Planner.Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meimad.Planner.Client.Windows.Views"
        Title="Meimad Production Planner" Icon="Assets/MeimadPlanner.ico"
        Width="1540" Height="940" MinWidth="1100" MinHeight="720"
        Style="{DynamicResource {x:Type Window}}"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="16,9">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggle" Content="Light workshop" Click="ThemeToggle_Click" ToolTip="Switch color theme" AutomationProperties.Name="Switch color theme" />
                    <ComboBox x:Name="LanguageSelector" Width="118" Height="30" Margin="0,0,10,0"
                              SelectedValuePath="Tag" SelectionChanged="LanguageSelector_SelectionChanged"
                              ToolTip="Application language" AutomationProperties.Name="Application language">
                        <ComboBoxItem Tag="en" Content="English" />
                        <ComboBoxItem Tag="he" Content="עברית" FlowDirection="RightToLeft" />
                        <ComboBoxItem Tag="ru" Content="Русский" />
                    </ComboBox>
                    <Border Width="28" Height="28" Background="Transparent" Margin="0,0,8,0"
                            AutomationProperties.Name="Server connection status">
                        <Border.ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="{Binding HealthHeadline}" FontWeight="Bold" />
                                <TextBlock Text="{Binding HealthDetail}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border.ToolTip>
                        <Ellipse x:Name="ServerStatusIndicator" Width="12" Height="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding HealthHeadline}"
                                 AutomationProperties.HelpText="{Binding HealthDetail}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource GreyBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="healthy"><Setter Property="Fill" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="attention"><Setter Property="Fill" Value="{StaticResource YellowBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="offline"><Setter Property="Fill" Value="{StaticResource RedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                AutomationProperties.Name="Signed-in user">
                        <TextBlock x:Name="SignedInUserText" Text="{Binding ModeHeadline}" Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold">
                            <TextBlock.ToolTip>
                                <TextBlock Text="{Binding ModeDetail}" TextWrapping="Wrap" MaxWidth="320" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Button Content="Sign in" Command="{Binding SignInCommand}" Height="30" Margin="0,0,4,0"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                ToolTip="Sign in with your user name and password" />
                        <Button Content="Password…" Click="ChangePassword_Click" Height="30" Margin="0,0,4,0"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Change your password" />
                        <Button Content="Sign out" Command="{Binding SignOutCommand}" Height="30" Margin="0,0,4,0"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="End your session on this computer" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MEIMAD" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="  PRODUCTION WORKBENCH" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.72"
                               FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock Text="Factory workspace" Foreground="{DynamicResource MutedTextBrush}" Width="174" VerticalAlignment="Center" />
                <WrapPanel>
                    <Button Content="Shop" Tag="1" Click="Workspace_Click" ToolTip="Open the Machine Planning Board and unassigned operation Pool" />
                    <Button Content="Preparation" Tag="6" Click="Workspace_Click" ToolTip="View assigned operations waiting for a valid current NC release" />
                    <Button Content="Operation" Tag="0" Click="Workspace_Click" ToolTip="Open Case" />
                    <Button Content="Integrations" Tag="4" Click="Workspace_Click" ToolTip="Open application and production setup" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Margin="0" Style="{StaticResource WorkbenchNavigation}">
            <TabItem Header="Cases">
                <views:CaseWorkspaceView DataContext="{Binding CaseWorkspace}" Margin="5" />
            </TabItem>
            <TabItem ToolTip="Open the Machine Planning Board and unassigned operation Pool">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource PlanningBoardButtonIcon}" Width="22" Height="22" Margin="0,0,6,0" /><TextBlock Text="Planning Board" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <views:MachinePlanningBoardView x:Name="PlanningBoardView" DataContext="{Binding MachinePlanningBoard}" Margin="5" />
            </TabItem>
            <TabItem x:Name="TimelineTab" ToolTip="Open the calculated Machine Timeline">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource TimelineButtonIcon}" Width="22" Height="22" Margin="0,0,6,0" /><TextBlock Text="Timeline" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,5">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TemplateIconButton}"
                                ToolTip="Open this same live, read-only Timeline in a reusable window."
                                AutomationProperties.Name="Open Timeline in separate window"
                                Click="OpenTimelineWindow_Click" Margin="0">
                            <Image Source="{StaticResource TimelineButtonIcon}" Width="24" Height="24" />
                        </Button>
                        <TextBlock Text="The Timeline is read-only and refreshes from committed Server state."
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <views:TimelineView x:Name="MainTimelineView" DataContext="{Binding Timeline}" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Shift Roster" ToolTip="Decide which 12h shift each employee on a shift rotation works, week by week">
                <views:ShiftRosterView DataContext="{Binding ShiftRoster}" Margin="5" />
            </TabItem>
            <TabItem ToolTip="Open application and production setup">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource SettingsButtonIcon}" Width="22" Height="22" Margin="0,0,6,0" /><TextBlock Text="Administration" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <views:SetupView x:Name="AdministrationView" DataContext="{Binding Setup}" Margin="5" />
            </TabItem>
            <TabItem Header="User Terminals" ToolTip="Monitor and configure E-Ink tablets">
                <views:UserTerminalsView DataContext="{Binding UserTerminals}" Margin="5" />
            </TabItem>
            <TabItem Header="NC Creator" ToolTip="View assigned operations waiting for a valid current NC release">
                <views:PreparationQueueView DataContext="{Binding NcCreatorQueue}" Margin="5" />
            </TabItem>
            <TabItem Header="Tool Room" ToolTip="View NC-ready operations waiting for tool preparation">
                <views:PreparationQueueView DataContext="{Binding ToolRoomQueue}" Margin="5" />
            </TabItem>
            <TabItem Header="Tool Catalog" ToolTip="Search and describe the factory's tools: internal id, type, hand, dimensions and external ids">
                <views:ToolCatalogView DataContext="{Binding ToolCatalog}" Margin="5" />
            </TabItem>
            <TabItem Header="Tool Requirements" ToolTip="The tools the planned operations of a period need, by material, type, size and name, with the copies and their moves between machines">
                <views:ToolRequirementsView DataContext="{Binding ToolRequirements}" Margin="5" />
            </TabItem>
            <TabItem Header="Setup Queue" ToolTip="View operations whose NC and Tool Room gates are complete">
                <views:PreparationQueueView DataContext="{Binding SetupQueue}" Margin="5" />
            </TabItem>
            <TabItem Header="QC Queue" ToolTip="Inspect Production Runs sent to Quality Control">
                <views:QcQueueView DataContext="{Binding QcQueue}" Margin="5" />
            </TabItem>
            <TabItem Header="Material Orders" ToolTip="Kitaron material purchase-order lines with their reported delivery status">
                <views:MaterialOrdersView DataContext="{Binding MaterialOrders}" Margin="5" />
            </TabItem>
            <TabItem Header="Reports" ToolTip="Machine usage per machine and overall, and each machine's DPRNT log">
                <TabControl Margin="5">
                    <TabItem Header="Machine Usage" ToolTip="Machine usage per machine and overall, in hours and percent, with the daily history">
                        <views:MachineUsageView DataContext="{Binding MachineUsage}" />
                    </TabItem>
                    <TabItem Header="DPRNT Log" ToolTip="Every line a machine's DPRNT output sent">
                        <views:DprntLogView DataContext="{Binding DprntLog}" />
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Users" ToolTip="Administrators: manage user accounts, user types and permissions"
                     Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:UserAdministrationView DataContext="{Binding UserAdministration}" Margin="5" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource RaisedBrush}" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding HealthHeadline}"
                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding HealthDetail}"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
