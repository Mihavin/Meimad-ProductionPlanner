<Window x:Class="Meimad.Planner.Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meimad.Planner.Client.Windows.Views"
        Title="Meimad Production Planner" Icon="Assets/MeimadPlanner.ico"
        Width="1380" Height="900" MinWidth="1100" MinHeight="720"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#18324A" Padding="16,9">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="LanguageSelector" Width="118" Height="30" Margin="0,0,10,0"
                              SelectedValuePath="Tag" SelectionChanged="LanguageSelector_SelectionChanged"
                              ToolTip="Application language" AutomationProperties.Name="Application language">
                        <ComboBoxItem Tag="en" Content="English" />
                        <ComboBoxItem Tag="he" Content="עברית" FlowDirection="RightToLeft" />
                        <ComboBoxItem Tag="ru" Content="Русский" />
                    </ComboBox>
                    <Border Width="28" Height="28" Background="Transparent" Margin="0,0,8,0"
                            AutomationProperties.Name="Server connection status">
                        <Border.ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="{Binding HealthHeadline}" FontWeight="Bold" />
                                <TextBlock Text="{Binding HealthDetail}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border.ToolTip>
                        <Ellipse x:Name="ServerStatusIndicator" Width="12" Height="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding HealthHeadline}"
                                 AutomationProperties.HelpText="{Binding HealthDetail}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource GreyBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="healthy"><Setter Property="Fill" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="attention"><Setter Property="Fill" Value="{StaticResource YellowBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="offline"><Setter Property="Fill" Value="{StaticResource RedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Border>

                    <Button x:Name="EditModeToggleButton" Click="ToggleEditMode_Click"
                            Width="30" Height="30" Padding="3" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="AutomationProperties.Name" Value="Edit Mode unavailable" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModeLevel}" Value="viewer">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Setter Property="AutomationProperties.Name" Value="Request Edit Mode" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModeLevel}" Value="editor">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Setter Property="AutomationProperties.Name" Value="Release Edit Mode" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModeLevel}" Value="requesting">
                                        <Setter Property="AutomationProperties.Name" Value="Edit Mode request pending" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Edit Mode unavailable" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModeLevel}" Value="viewer"><Setter Property="Text" Value="Request Edit Mode" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ModeLevel}" Value="editor"><Setter Property="Text" Value="Release Edit Mode" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ModeLevel}" Value="requesting"><Setter Property="Text" Value="Edit Mode request pending" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ModeDetail}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button.ToolTip>
                        <Grid Width="16" Height="16">
                            <Grid x:Name="LockedIcon">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModeLevel}" Value="editor">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Data="M4,7 L4,5 C4,2.8 5.8,1 8,1 C10.2,1 12,2.8 12,5 L12,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Border Width="12" Height="9" VerticalAlignment="Bottom" CornerRadius="1"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                            <Grid x:Name="UnlockedIcon">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModeLevel}" Value="editor">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Data="M12,7 L12,5 C12,2.8 10.2,1 8,1 C5.8,1 4,2.8 4,5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Border Width="12" Height="9" VerticalAlignment="Bottom" CornerRadius="1"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MEIMAD" Foreground="White" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="  PRODUCTION PLANNER" Foreground="White" Opacity="0.72"
                               FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="{StaticResource YellowBrush}"
                BorderThickness="0,0,0,1" Padding="12,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPendingTransfer}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Release / Transfer" Command="{Binding ApproveTransferCommand}" />
                    <Button Content="Reject" Command="{Binding RejectTransferCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding PendingTransferText}" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Margin="12,8,12,6">
            <TabItem Header="Cases">
                <views:CaseWorkspaceView DataContext="{Binding CaseWorkspace}" Margin="5" />
            </TabItem>
            <TabItem ToolTip="Open the Machine Planning Board and unassigned operation Pool">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource PlanningBoardButtonIcon}" Width="22" Height="22" Margin="0,0,6,0" /><TextBlock Text="Planning Board" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <views:MachinePlanningBoardView DataContext="{Binding MachinePlanningBoard}" Margin="5" />
            </TabItem>
            <TabItem x:Name="TimelineTab" ToolTip="Open the calculated Machine Timeline">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource TimelineButtonIcon}" Width="22" Height="22" Margin="0,0,6,0" /><TextBlock Text="Timeline" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,5">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TemplateIconButton}"
                                ToolTip="Open this same live, read-only Timeline in a reusable window."
                                AutomationProperties.Name="Open Timeline in separate window"
                                Click="OpenTimelineWindow_Click" Margin="0">
                            <Image Source="{StaticResource TimelineButtonIcon}" Width="24" Height="24" />
                        </Button>
                        <TextBlock Text="The Timeline is read-only and refreshes from committed Server state."
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <views:TimelineView DataContext="{Binding Timeline}" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem ToolTip="Open application and production setup">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource SettingsButtonIcon}" Width="22" Height="22" Margin="0,0,6,0" /><TextBlock Text="Setup" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <views:SetupView DataContext="{Binding Setup}" Margin="5" />
            </TabItem>
            <TabItem Header="User Terminals" ToolTip="Monitor and configure E-Ink tablets">
                <views:UserTerminalsView DataContext="{Binding UserTerminals}" Margin="5" />
            </TabItem>
            <TabItem Header="QC Queue" ToolTip="Inspect Production Runs sent to Quality Control">
                <views:QcQueueView DataContext="{Binding QcQueue}" Margin="5" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#E7EBEF" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="No direct database access"
                           FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                <TextBlock Text="Status and the separate Timeline refresh while the Server is available."
                           Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
