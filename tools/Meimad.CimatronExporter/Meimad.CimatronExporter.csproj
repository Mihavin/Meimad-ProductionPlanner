<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cimatron -> Meimad simulation package exporter (console). It talks to a running Cimatron through
    late-bound COM only (no Cimatron interop assemblies are referenced, so it builds on any PC) and
    writes a package that the Meimad Server validates and imports. UNVERIFIED against a real Cimatron:
    see docs/cimatron-exporter.md before using it in production.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Meimad.CimatronExporter</RootNamespace>
    <AssemblyName>Meimad.CimatronExporter</AssemblyName>
    <Version>0.3.1</Version>
    <IsPackable>false</IsPackable>
    <!-- The one-click exporter window (started with no argument, ui or from-post) is Windows Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the console code free of Windows Forms names; the window files import them explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Meimad.Planner.SimulationPackage\Meimad.Planner.SimulationPackage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Launch\*.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Beside the exe, so the CAM user double-clicks install-shortcuts.cmd in the exporter folder. -->
    <None Include="Launch\install-shortcuts.ps1;Launch\install-shortcuts.cmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meimad.Planner.Server.Tests" />
  </ItemGroup>

</Project>
