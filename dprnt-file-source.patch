diff --git a/server/Meimad.Planner.Server/Infrastructure/Haas/HaasDprntFileReader.cs b/server/Meimad.Planner.Server/Infrastructure/Haas/HaasDprntFileReader.cs
new file mode 100644
index 0000000..64aa19d
--- /dev/null
+++ b/server/Meimad.Planner.Server/Infrastructure/Haas/HaasDprntFileReader.cs
@@ -0,0 +1,148 @@
+using System.Text;
+
+namespace Meimad.Planner.Server.Infrastructure.Haas;
+
+/// <summary>
+/// Tails a controller-written DPRNT text file (for example the Mazak Matrix
+/// <c>print.txt</c> written when DPR14 = 4) over a network share. Only lines
+/// appended since the previous poll are returned; a file that was rewritten,
+/// shortened, or emptied by the controller is read again from the start.
+/// Read errors propagate to the caller, which owns the availability decision.
+/// </summary>
+internal sealed class HaasDprntFileReader
+{
+    private const int FingerprintLength = 256;
+    private const int MaximumBytesPerPoll = 1024 * 1024;
+    private long offset;
+    private byte[] fingerprint = [];
+    private DateTime lastWriteTimeUtc;
+    private readonly StringBuilder pending = new();
+
+    /// <summary>Set when the optional post-read truncation failed; cleared by the next successful truncation or read without truncation.</summary>
+    internal string? LastTruncateError { get; private set; }
+
+    internal async Task<HaasDprntDrainResult> DrainAsync(string path, bool truncateAfterRead, CancellationToken token)
+    {
+        for (var attempt = 1; ; attempt++)
+        {
+            try
+            {
+                return await DrainOnceAsync(path, truncateAfterRead, token);
+            }
+            catch (IOException exception) when (attempt < 3 && IsSharingViolation(exception))
+            {
+                // The controller briefly holds the file exclusively while it appends a line.
+                await Task.Delay(100, token);
+            }
+        }
+    }
+
+    private async Task<HaasDprntDrainResult> DrainOnceAsync(string path, bool truncateAfterRead, CancellationToken token)
+    {
+        long length;
+        byte[] head;
+        byte[] buffer;
+        DateTime writeTime;
+        await using (var stream = new FileStream(path, new FileStreamOptions
+        {
+            Mode = FileMode.Open,
+            Access = FileAccess.Read,
+            Share = FileShare.ReadWrite | FileShare.Delete,
+            Options = FileOptions.Asynchronous
+        }))
+        {
+            length = stream.Length;
+            writeTime = File.GetLastWriteTimeUtc(path);
+            if (length == 0)
+            {
+                Reset(keepPartialLine: false);
+                lastWriteTimeUtc = writeTime;
+                if (!truncateAfterRead) LastTruncateError = null;
+                return new(null, []);
+            }
+            head = new byte[(int)Math.Min(length, FingerprintLength)];
+            await stream.ReadExactlyAsync(head, token);
+            var rewritten = length < offset
+                || !StartsWith(head, fingerprint)
+                || (length == offset && writeTime != lastWriteTimeUtc);
+            if (rewritten) Reset(keepPartialLine: false);
+            lastWriteTimeUtc = writeTime;
+            if (length == offset)
+            {
+                if (!truncateAfterRead) LastTruncateError = null;
+                return new(null, []);
+            }
+            var count = (int)Math.Min(length - offset, MaximumBytesPerPoll);
+            buffer = new byte[count];
+            stream.Position = offset;
+            await stream.ReadExactlyAsync(buffer, token);
+            offset += count;
+            fingerprint = head;
+        }
+
+        pending.Append(Encoding.UTF8.GetString(buffer).Replace("\0", string.Empty, StringComparison.Ordinal));
+        string? latest = null;
+        var eventLines = new List<string>();
+        var text = pending.ToString();
+        var lines = text.Split(["\r\n", "\n", "\r"], StringSplitOptions.None);
+        pending.Clear();
+        pending.Append(lines[^1]);
+        foreach (var line in lines[..^1])
+        {
+            if (HaasDprntPartReader.TryParsePartName(line, out var value)) latest = value;
+            else if (line.TrimStart().StartsWith("MEIMAD/", StringComparison.Ordinal))
+                eventLines.Add(line.Trim());
+        }
+
+        if (truncateAfterRead && offset == length)
+            TruncateConsumedFile(path, length);
+        else if (!truncateAfterRead)
+            LastTruncateError = null;
+        return new(latest, eventLines);
+    }
+
+    /// <summary>
+    /// Empties the file only when it still ends exactly where this reader stopped, so a
+    /// line the controller appended between the read and the truncation is never lost.
+    /// </summary>
+    private void TruncateConsumedFile(string path, long consumedLength)
+    {
+        try
+        {
+            using var stream = new FileStream(path, new FileStreamOptions
+            {
+                Mode = FileMode.Open,
+                Access = FileAccess.ReadWrite,
+                Share = FileShare.ReadWrite | FileShare.Delete
+            });
+            if (stream.Length != consumedLength) return;
+            stream.SetLength(0);
+            LastTruncateError = null;
+            Reset(keepPartialLine: true);
+            lastWriteTimeUtc = File.GetLastWriteTimeUtc(path);
+        }
+        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
+        {
+            LastTruncateError = "DPRNT file could not be truncated after reading: " + Safe(exception.Message);
+        }
+    }
+
+    private void Reset(bool keepPartialLine)
+    {
+        offset = 0;
+        fingerprint = [];
+        if (!keepPartialLine) pending.Clear();
+    }
+
+    /// <summary>Windows ERROR_SHARING_VIOLATION (32) and ERROR_LOCK_VIOLATION (33).</summary>
+    private static bool IsSharingViolation(IOException exception) => (exception.HResult & 0xFFFF) is 32 or 33;
+
+    private static bool StartsWith(byte[] head, byte[] prefix)
+    {
+        if (prefix.Length == 0) return true;
+        if (head.Length < prefix.Length) return false;
+        return head.AsSpan(0, prefix.Length).SequenceEqual(prefix);
+    }
+
+    private static string Safe(string value) => value.Length <= 400 ? value : value[..400];
+}
